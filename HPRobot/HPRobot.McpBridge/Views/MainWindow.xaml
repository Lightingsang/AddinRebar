<Window x:Class="HPRobot.McpBridge.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HPRobot.McpBridge.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="HPRobot MCP Bridge — 2026"
        Icon="/Resources/HPRobotMcpBridge.ico"
        Width="640" Height="820"
        MinWidth="540" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource Font.Family.Default}"
        FontSize="{DynamicResource Font.Size.Body}"
        Foreground="{DynamicResource Brush.Foreground.Primary}">

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="StatusDot" TargetType="Ellipse">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Fill" Value="{DynamicResource Brush.Foreground.Tertiary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Core.StatusKind}" Value="Listening">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Info}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Core.StatusKind}" Value="Connected">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Core.StatusKind}" Value="Busy">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Core.StatusKind}" Value="Error">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{DynamicResource Spacing.Medium}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 1: Header / Named Pipe Listener Status -->
            <Border Grid.Row="0" Style="{DynamicResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Style="{DynamicResource StatusDot}" Margin="{DynamicResource Spacing.SmallHorizontal}"/>

                    <StackPanel Grid.Column="1" Margin="{DynamicResource Spacing.SmallHorizontal}">
                        <TextBlock Style="{DynamicResource Subheading}" Text="HPRobot MCP Bridge" Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Style="{DynamicResource BodyStrong}" Text="{Binding Core.StatusText}" TextWrapping="Wrap"/>
                        <TextBlock Style="{DynamicResource Caption}" Text="{Binding Core.StatusDetail}" Foreground="{DynamicResource Brush.Danger}"/>
                        <TextBlock Style="{DynamicResource Caption}">
                            <Run Text="Pipe:"/> <Run Text="{Binding Core.PipeName, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="· Host: Autodesk Robot Structural Analysis 2026"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{DynamicResource PrimaryButton}" MinWidth="130" VerticalAlignment="Center"
                            Content="{Binding Core.ToggleButtonText}" Command="{Binding Core.ToggleListenerCommand}"/>
                </Grid>
            </Border>

            <!-- Card 2: Robot COM Connection & Active Model -->
            <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="{DynamicResource Spacing.MediumTop}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{DynamicResource BodyStrong}" Text="Autodesk Robot Connection" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{DynamicResource LinkButton}" Content="Refresh" Margin="0,0,8,0"
                                Command="{Binding RefreshStateCommand}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{DynamicResource PrimaryButton}" Content="Attach" Margin="0,0,6,0"
                                    Command="{Binding AttachCommand}"/>
                            <Button Style="{DynamicResource SecondaryButton}" Content="Detach"
                                    Command="{Binding DetachCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Connection Facts -->
                    <Border Background="{DynamicResource Brush.Background}" CornerRadius="4" Padding="{DynamicResource Spacing.Small}"
                            Margin="{DynamicResource Spacing.SmallTop}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource Caption}" Text="Status:"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{DynamicResource Caption}" Text="{Binding AttachStatusText}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{DynamicResource Caption}" Text="Active Model:"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{DynamicResource Caption}" Text="{Binding ActiveModelFileName}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{DynamicResource Caption}" Text="Structure Type:"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{DynamicResource Caption}">
                                <Run Text="{Binding StructureType}"/> <Run Text="· Solver:"/> <Run Text="{Binding CalculatedStatusText}" FontWeight="SemiBold"/>
                            </TextBlock>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{DynamicResource Caption}" Text="Elements:"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{DynamicResource Caption}">
                                <Run Text="Nodes:"/> <Run Text="{Binding NodeCount}" FontWeight="SemiBold"/>
                                <Run Text="· Bars:"/> <Run Text="{Binding BarCount}" FontWeight="SemiBold"/>
                                <Run Text="· Panels:"/> <Run Text="{Binding PanelCount}" FontWeight="SemiBold"/>
                                <Run Text="· Cases:"/> <Run Text="{Binding LoadCaseCount}" FontWeight="SemiBold"/>
                            </TextBlock>

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{DynamicResource Caption}" Text="Full Path:"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{DynamicResource Caption}" Text="{Binding ActiveModelPath}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 3: 3-Tier Safety Gating Controls -->
            <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="{DynamicResource Spacing.MediumTop}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource BodyStrong}" Text="3-Tier Safety &amp; Mutation Permissions"/>
                    <TextBlock Style="{DynamicResource Caption}" Text="Control what the connected AI agent is allowed to execute on your structural models."/>

                    <StackPanel Margin="{DynamicResource Spacing.SmallTop}">
                        <!-- Tier R & W -->
                        <CheckBox IsChecked="{Binding IsExecutionEnabled}" Margin="0,4"
                                  AutomationProperties.AutomationId="AllowExecution" AutomationProperties.Name="Allow AI execution">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource BodyStrong}" Text="Allow AI execution (Tier R: Read, Tier W: Write) — Auto-Snapshot"/>
                                <TextBlock Style="{DynamicResource Caption}" Text="Permits queries and geometry/load mutations. Automatic timestamped .rtd snapshot is captured before writing."/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Tier D / Heavy -->
                        <CheckBox IsChecked="{Binding IsHeavyOperationsEnabled}" IsEnabled="{Binding CanEnableHeavyOperations}" Margin="0,6"
                                  AutomationProperties.AutomationId="AllowHeavy" AutomationProperties.Name="Allow heavy operations">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource BodyStrong}" Text="Allow heavy operations &amp; FEA solver (Tier D: Heavy / Deletions) — Auto-Snapshot"
                                           Foreground="{DynamicResource Brush.Danger}"/>
                                <TextBlock Style="{DynamicResource Caption}" Text="Permits deleting structural elements, clearing models, and running FEA calculations (Calculate()). Automatic .rtd backup created."/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 4: Last Run / AI Generated Code Preview -->
            <Border Grid.Row="3" Style="{DynamicResource Card}" Margin="{DynamicResource Spacing.MediumTop}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Style="{DynamicResource LinkButton}" Content="Copy script"
                                Command="{Binding Core.CopyLastScriptCommand}"/>
                        <TextBlock Style="{DynamicResource BodyStrong}" Text="Last run (AI Generated Code)"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Style="{DynamicResource Caption}" Margin="{DynamicResource Spacing.SmallTop}"
                               Text="{Binding Core.LastRunSummary, Mode=OneWay}" TextWrapping="Wrap"/>

                    <TextBox Grid.Row="2" Style="{DynamicResource StandardTextBox}" Margin="{DynamicResource Spacing.SmallTop}"
                             Text="{Binding Core.LastScriptPreview, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="{DynamicResource Font.Family.Mono}" FontSize="{DynamicResource Font.Size.Caption}"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             MinHeight="140" MaxHeight="260"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

                    <TextBlock Grid.Row="3" Style="{DynamicResource Caption}" Margin="0,8,0,0">
                        <Run Text="Compiled scripts:"/> <Run Text="{Binding Core.CompiledScriptCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" (cached in-memory)"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Card 5: Footer Utility Links -->
            <Grid Grid.Row="4" Margin="{DynamicResource Spacing.MediumTop}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{DynamicResource Caption}" VerticalAlignment="Center"
                           Text="HPRobot MCP Bridge · RobotOM COM Interop"/>
                <Button Grid.Column="1" Style="{DynamicResource LinkButton}" Content="Open Snapshots Folder"
                        Command="{Binding OpenSnapshotFolderCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Style="{DynamicResource LinkButton}" Content="Open Logs Folder"
                        Command="{Binding OpenLogFolderCommand}"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
