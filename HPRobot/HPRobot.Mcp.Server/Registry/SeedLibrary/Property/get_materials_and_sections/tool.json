    "type": "object",
    "properties": {
      "includeMaterials": {
        "type": "boolean",
        "default": true,
        "description": "Include material definitions."
      },
      "includeSections": {
        "type": "boolean",
        "default": true,
        "description": "Include bar cross-section definitions."
      }
    },
    "additionalProperties": false
  }
}
