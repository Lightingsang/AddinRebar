<Window x:Class="HPAutoCad.HPGeoLink.View.GeoImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:view="clr-namespace:HPAutoCad.HPGeoLink.View"
        xmlns:vm="clr-namespace:HPAutoCad.HPGeoLink.ViewModel"
        Title="HPAutoCad · Nhập toạ độ vào bản vẽ"
        Width="1020" Height="740" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <md:PackIcon Kind="FileImportOutline" Width="24" Height="24" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Text.Title}" Text="WGS84 / VN-2000 → POINT + LWPOLYLINE" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Nhập toạ độ vào AutoCAD" Style="{StaticResource Text.Muted}" FontSize="11" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="4" Padding="8,3">
                <TextBlock Text="AutoCAD 2026 .NET 8" Foreground="{DynamicResource Brush.Accent}" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <!-- 1. Source Data Card -->
        <Border Grid.Row="1" Style="{StaticResource Card.Panel}">
            <StackPanel>
                <!-- Card Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <md:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Nguồn dữ liệu toạ độ" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Mode A: KML/KMZ File -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="File KML/KMZ" IsChecked="{Binding SourceIsFile}" VerticalAlignment="Center"/>
                    <DockPanel Grid.Column="1" IsEnabled="{Binding SourceIsFile}">
                        <Button Command="{Binding BrowseFileCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" Height="36">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Chọn file…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBox Style="{StaticResource StandardTextBox}"
                                 MinHeight="36"
                                 VerticalContentAlignment="Center"
                                 md:HintAssist.Hint="Đường dẫn file Google Earth (.kml / .kmz)"
                                 md:HintAssist.IsFloating="False"
                                 Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="File Google Earth (Save Place As…) hoặc KMZ do HPGeo xuất"/>
                    </DockPanel>
                </Grid>

                <!-- Mode B: Pasted Coordinates -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="Dán toạ độ" IsChecked="{Binding SourceIsText}" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    <Grid Grid.Column="1" IsEnabled="{Binding SourceIsText}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <RadioButton Content="WGS84 lat, lon" IsChecked="{Binding PastedIsWgs84}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <RadioButton Content="VN-2000 E,N / X,Y" IsChecked="{Binding PastedIsWgs84, Converter={x:Static view:InverseBoolConverter.Instance}}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <ComboBox Width="180" MinHeight="36" Margin="0,0,16,0" VerticalAlignment="Center"
                                      Style="{StaticResource StandardComboBox}"
                                      md:HintAssist.Hint="Thứ tự toạ độ"
                                      md:HintAssist.IsFloating="False"
                                      VerticalContentAlignment="Center"
                                      SelectedIndex="{Binding PairOrderIndex}"
                                      IsEnabled="{Binding PastedIsWgs84, Converter={x:Static view:InverseBoolConverter.Instance}}">
                                <ComboBoxItem Content="Tự nhận dạng"/>
                                <ComboBoxItem Content="E, N (AutoCAD)"/>
                                <ComboBoxItem Content="X, Y địa chính (X = N)"/>
                            </ComboBox>
                            <CheckBox Content="Nối thành polyline" IsChecked="{Binding JoinAsPolyline}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <CheckBox Content="Đóng ranh" IsChecked="{Binding CloseRing}" IsEnabled="{Binding JoinAsPolyline}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Height="86" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                 FontFamily="Consolas" FontSize="11"
                                 md:HintAssist.Hint="Mỗi dòng một điểm: 'POINT 600125.887,1231608.428', 'M1 10.7769 106.7009', 'lat, lon'…"
                                 Text="{Binding PastedText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Dán danh sách toạ độ vào đây"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. Coordinate system Card -->
        <view:CrsSelectionView Grid.Row="2" Margin="0,0,0,12" DataContext="{Binding Crs}"/>

        <!-- 3. Preview Card -->
        <Border Grid.Row="3" Style="{StaticResource Card.Panel}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2,0,6">
                    <md:PackIcon Kind="TableLarge" Width="16" Height="16" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Bảng xem trước toạ độ (Preview)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Preview}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="90"/>
                        <DataGridTextColumn Header="Lat" Binding="{Binding Lat}" Width="100"/>
                        <DataGridTextColumn Header="Lon" Binding="{Binding Lon}" Width="105"/>
                        <DataGridTextColumn Header="E (m)" Binding="{Binding Easting}" Width="105"/>
                        <DataGridTextColumn Header="N (m)" Binding="{Binding Northing}" Width="110"/>
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 4. Issues + Status -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <Border Background="#33E0B341" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="4"
                    Padding="10,6" Margin="0,0,0,6"
                    Visibility="{Binding IssuesText, Converter={x:Static view:NonEmptyToVisibilityConverter.Instance}}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="AlertCircleOutline" Width="16" Height="16" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding IssuesText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="InformationOutline" Width="15" Height="15" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
            </StackPanel>
        </StackPanel>

        <!-- 5. Actions Footer Toolbar -->
        <Border Grid.Row="5" Style="{StaticResource Card.Panel}" Padding="12,8" Margin="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding DrawCommand}" IsEnabled="{Binding CanDraw}" Height="34" Margin="0,0,8,0"
                        ToolTip="Vẽ các điểm POINT và polyline ranh vào bản vẽ AutoCAD">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="DrawPen" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Vẽ vào bản vẽ" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CloseCommand}" Margin="0" Height="34">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đóng" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
