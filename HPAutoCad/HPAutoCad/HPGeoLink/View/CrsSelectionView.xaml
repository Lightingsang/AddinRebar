<UserControl x:Class="HPAutoCad.HPGeoLink.View.CrsSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:view="clr-namespace:HPAutoCad.HPGeoLink.View">
    <!-- DataContext = CrsSelectionViewModel (set by the owner through binding). -->
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="6" Padding="14,10">
        <StackPanel>
            <!-- Card Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <md:PackIcon Kind="CrosshairsGps" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Hệ toạ độ VN-2000 (TM-3)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Row 1: Coordinate inputs (Tỉnh/thành, Kinh tuyến trục, Giá trị) -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <!-- Province ComboBox -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="TỈNH / THÀNH" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,4"/>
                    <ComboBox MinHeight="36" VerticalContentAlignment="Center"
                              Style="{StaticResource StandardComboBox}"
                              ItemsSource="{Binding Provinces}" SelectedItem="{Binding SelectedProvince}"
                              IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" StaysOpenOnEdit="True"
                              ToolTip="Gõ tên tỉnh để tìm kiếm; tỉnh có nhiều kinh tuyến trục sẽ yêu cầu chọn KTT">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Brush.TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Meridian ComboBox -->
                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                    <TextBlock Text="KINH TUYẾN TRỤC" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,4"/>
                    <ComboBox MinHeight="36" VerticalContentAlignment="Center"
                              Style="{StaticResource StandardComboBox}"
                              ItemsSource="{Binding Meridians}" SelectedItem="{Binding SelectedMeridian}"
                              DisplayMemberPath="Label"
                              ToolTip="Kinh tuyến trục theo hồ sơ địa chính; tỉnh gộp hiện tên tỉnh cũ"/>
                </StackPanel>

                <!-- Central Meridian Degree TextBox -->
                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                    <TextBlock Text="GIÁ TRỊ" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,4"/>
                    <TextBox MinHeight="36" VerticalContentAlignment="Center"
                             Style="{StaticResource StandardTextBox}"
                             Text="{Binding CentralMeridianText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Nhập tay khi hồ sơ ghi KTT khác, vd 105.75 hoặc 105°45′"/>
                </StackPanel>
            </Grid>

            <!-- Row 2: Catalog Radios -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                <RadioButton Content="34 tỉnh/thành (2025)" IsChecked="{Binding UseCurrentCatalog}" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <RadioButton Content="63 tỉnh/thành (cũ)" IsChecked="{Binding UseCurrentCatalog, Converter={x:Static view:InverseBoolConverter.Instance}}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Row 3: Advanced parameters expander (k0, FE, FN, Ellipsoid / Đơn vị) -->
            <Expander Header="Thông số nâng cao (k₀, False Easting, False Northing, Đơn vị)"
                      IsExpanded="False" Margin="0,0,0,0" Padding="0,4,0,0">
                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="k₀" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,4"/>
                        <TextBox MinHeight="34" VerticalContentAlignment="Center"
                                 Style="{StaticResource StandardTextBox}"
                                 Text="{Binding K0Text, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Hệ số co giãn kinh tuyến trục (TM-3 là 0.9999)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,6,0">
                        <TextBlock Text="False Easting" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,4"/>
                        <TextBox MinHeight="34" VerticalContentAlignment="Center"
                                 Style="{StaticResource StandardTextBox}"
                                 Text="{Binding FalseEastingText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Độ dời trục hoành (thường là 500000 m)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,6,0">
                        <TextBlock Text="False Northing" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,4"/>
                        <TextBox MinHeight="34" VerticalContentAlignment="Center"
                                 Style="{StaticResource StandardTextBox}"
                                 Text="{Binding FalseNorthingText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Độ dời trục tung (thường là 0 m)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="4,0,0,0">
                        <TextBlock Text="Ellipsoid" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,4"/>
                        <ComboBox MinHeight="34" VerticalContentAlignment="Center"
                                  Style="{StaticResource StandardComboBox}"
                                  ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="Label"
                                  ToolTip="Đơn vị của toạ độ trong bản vẽ (INSUNITS); VN-2000 tính bằng mét"/>
                    </StackPanel>
                </Grid>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
