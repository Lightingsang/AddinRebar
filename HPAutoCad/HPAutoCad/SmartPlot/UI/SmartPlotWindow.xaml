<Window x:Class="HPAutoCad.SmartPlot.UI.SmartPlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:HPAutoCad.SmartPlot.UI"
        xmlns:models="clr-namespace:HPAutoCad.Core.SmartPlot.Models;assembly=HPAutoCad.Core"
        Title="HPAutoCad · Smart Plot Pro"
        Width="1020" Height="720" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">

    <Window.Resources>
        <local:EnumToBooleanConverter x:Key="EnumToBoolConverter"/>
        <local:EnumToVisibilityConverter x:Key="EnumToVisConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:BoolToVisibilityConverter x:Key="InvBoolToVisConverter" Invert="True"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <DockPanel Grid.Row="0" Margin="{DynamicResource Margin.Section}">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Style="{StaticResource Text.Title}" Text="Smart Plot Pro" VerticalAlignment="Center"/>
                <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding ActiveDocumentName}" VerticalAlignment="Center"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="3" Padding="8,3">
                <TextBlock Text="AutoCAD 2026 .NET 8" Foreground="{DynamicResource Brush.Accent}" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <!-- 2. Progress Banner (Visible when busy) -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,8"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Accent}"
                BorderThickness="1" CornerRadius="4"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ProgressBar Height="6" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressCurrent}"
                                 Foreground="{DynamicResource Brush.Accent}"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                        Content="Hủy" Command="{Binding CancelCommand}"/>
            </Grid>
        </Border>

        <!-- 3. Main TabControl -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: PLOT -->
            <TabItem Header="In ấn (Plot)">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Settings Cards -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">

                            <!-- Card: Frame Source -->
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Section}" Text="1. Nguồn khung in (Frame Source)"/>
                                    <StackPanel Orientation="Horizontal" Margin="{DynamicResource Margin.Row}">
                                        <RadioButton Content="Block khung"
                                                     IsChecked="{Binding FrameSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Block}"/>
                                        <RadioButton Content="Layer Polyline"
                                                     IsChecked="{Binding FrameSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Layer}"/>
                                        <RadioButton Content="Layouts"
                                                     IsChecked="{Binding FrameSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Layout}"/>
                                    </StackPanel>

                                    <!-- Block configuration fields -->
                                    <StackPanel Visibility="{Binding FrameSource, Converter={StaticResource EnumToVisConverter}, ConverterParameter=Block}">
                                        <Grid Margin="{DynamicResource Margin.Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" IsEditable="True"
                                                      ItemsSource="{Binding AvailableBlocks}"
                                                      Text="{Binding BlockName, UpdateSourceTrigger=PropertyChanged}"
                                                      md:HintAssist.Hint="Tên Block khung bản vẽ"/>
                                            <Button Grid.Column="1" Margin="8,0,0,0" Content="Chọn mẫu"
                                                    Command="{Binding PickFrameCommand}" ToolTip="Chọn Block trực tiếp từ bản vẽ"/>
                                        </Grid>
                                        <Grid Margin="{DynamicResource Margin.Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding SheetNumberAttribute, UpdateSourceTrigger=PropertyChanged}"
                                                     md:HintAssist.Hint="Tag số hiệu (vd: SOHIEU)"/>
                                            <TextBox Grid.Column="2" Text="{Binding SheetTitleAttribute, UpdateSourceTrigger=PropertyChanged}"
                                                     md:HintAssist.Hint="Tag tiêu đề (vd: TENTIEUDE)"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Layer configuration fields -->
                                    <StackPanel Visibility="{Binding FrameSource, Converter={StaticResource EnumToVisConverter}, ConverterParameter=Layer}">
                                        <Grid Margin="{DynamicResource Margin.Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" IsEditable="True"
                                                      ItemsSource="{Binding AvailableLayers}"
                                                      Text="{Binding LayerName, UpdateSourceTrigger=PropertyChanged}"
                                                      md:HintAssist.Hint="Layer chứa Polyline khung"/>
                                            <Button Grid.Column="1" Margin="8,0,0,0" Content="Chọn mẫu"
                                                    Command="{Binding PickFrameCommand}" ToolTip="Chọn Polyline trực tiếp từ bản vẽ"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Layout configuration fields -->
                                    <StackPanel Visibility="{Binding FrameSource, Converter={StaticResource EnumToVisConverter}, ConverterParameter=Layout}">
                                        <TextBox Text="{Binding LayoutRange, UpdateSourceTrigger=PropertyChanged}"
                                                 md:HintAssist.Hint="Phạm vi Layout (vd: All, 1-5, 1,3,5)"
                                                 Margin="{DynamicResource Margin.Row}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card: Printer & Paper -->
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Section}" Text="2. Máy in &amp; Khổ giấy (Device &amp; Paper)"/>
                                    <ComboBox ItemsSource="{Binding Devices}"
                                              Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              md:HintAssist.Hint="Máy in (PC3 / System Printer)"
                                              Margin="{DynamicResource Margin.Row}"/>
                                    <ComboBox ItemsSource="{Binding MediaSizes}"
                                              Text="{Binding MediaName, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              md:HintAssist.Hint="Khổ giấy (Paper Size)"
                                              Margin="{DynamicResource Margin.Row}"/>
                                    <ComboBox ItemsSource="{Binding PlotStyles}"
                                              Text="{Binding PlotStyle, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              md:HintAssist.Hint="Bảng nét in (Plot Style CTB/STB)"
                                              Margin="0,0,0,4"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Orientation & Scale -->
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Section}" Text="3. Chiều in &amp; Tỷ lệ (Orientation &amp; Scale)"/>
                                    <StackPanel Orientation="Horizontal" Margin="{DynamicResource Margin.Row}">
                                        <RadioButton Content="Tự động (Auto)"
                                                     IsChecked="{Binding Orientation, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Auto}"/>
                                        <RadioButton Content="Khổ ngang"
                                                     IsChecked="{Binding Orientation, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Landscape}"/>
                                        <RadioButton Content="Khổ dọc"
                                                     IsChecked="{Binding Orientation, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Portrait}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <CheckBox Content="Vừa trang giấy (Fit)" IsChecked="{Binding FitToPaper}" Margin="0,0,20,0"/>
                                        <CheckBox Content="Căn giữa (Center)" IsChecked="{Binding CenterPlot}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card: Output & Naming -->
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Section}" Text="4. Xuất file &amp; Đặt tên (Output &amp; Naming)"/>
                                    <Grid Margin="{DynamicResource Margin.Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                                 md:HintAssist.Hint="Thư mục xuất PDF"/>
                                        <Button Grid.Column="1" Margin="8,0,0,0" Content="..." MinWidth="36"
                                                Command="{Binding BrowseOutputFolderCommand}" ToolTip="Chọn thư mục"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="{DynamicResource Margin.Row}">
                                        <RadioButton Content="Từng file riêng lẻ"
                                                     IsChecked="{Binding OutputMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SingleFiles}"/>
                                        <RadioButton Content="Gộp 1 file PDF (Merged)"
                                                     IsChecked="{Binding OutputMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MergedPdf}"/>
                                    </StackPanel>
                                    <Grid Margin="{DynamicResource Margin.Row}"
                                          Visibility="{Binding OutputMode, Converter={StaticResource EnumToVisConverter}, ConverterParameter=SingleFiles}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FileNamePrefix, UpdateSourceTrigger=PropertyChanged}"
                                                 md:HintAssist.Hint="Tiền tố"/>
                                        <TextBox Grid.Column="2" Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged}"
                                                 md:HintAssist.Hint="Mẫu đặt tên {Prefix}_{Layout}_{SheetNo}_{Title}"/>
                                    </Grid>
                                    <TextBox Text="{Binding MergedFileName, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="Tên file PDF gộp (Merged file name)"
                                             Margin="0,0,0,4"
                                             Visibility="{Binding OutputMode, Converter={StaticResource EnumToVisConverter}, ConverterParameter=MergedPdf}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter Separator -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="{DynamicResource Brush.Border}"/>

                    <!-- Right Column: Frames DataGrid -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Grid Toolbar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Khung phát hiện: " FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedCount}" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"/>
                                <TextBlock Text=" / "/>
                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold"/>
                                <TextBlock Text=" bản vẽ" Margin="0,0,16,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="Chọn hết" MinWidth="70" Padding="4,2" Margin="0,0,4,0" Command="{Binding SelectAllCommand}"/>
                                <Button Content="Bỏ chọn" MinWidth="70" Padding="4,2" Margin="0,0,4,0" Command="{Binding DeselectAllCommand}"/>
                                <Button Content="Đảo chọn" MinWidth="70" Padding="4,2" Margin="0,0,4,0" Command="{Binding InvertSelectionCommand}"/>
                                <Button Content="Sắp xếp" MinWidth="70" Padding="4,2" Margin="0,0,4,0" Command="{Binding AutoSortItemsCommand}" ToolTip="Sắp xếp lại theo thứ tự từ trên xuống dưới, trái sang phải"/>
                                <Button Content="▲" MinWidth="32" Padding="4,2" Margin="0,0,2,0"
                                        Command="{Binding MoveItemUpCommand}" CommandParameter="{Binding ElementName=FramesGrid, Path=SelectedItem}" ToolTip="Di chuyển lên"/>
                                <Button Content="▼" MinWidth="32" Padding="4,2"
                                        Command="{Binding MoveItemDownCommand}" CommandParameter="{Binding ElementName=FramesGrid, Path=SelectedItem}" ToolTip="Di chuyển xuống"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- DataGrid -->
                        <DataGrid x:Name="FramesGrid" Grid.Row="1"
                                  ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="In" Width="42"
                                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="STT" Width="45"
                                                    Binding="{Binding Order}"/>
                                <DataGridTextColumn Header="Layout" Width="70"
                                                    Binding="{Binding LayoutName}"/>
                                <DataGridTextColumn Header="Số hiệu" Width="85"
                                                    Binding="{Binding SheetNumber}"/>
                                <DataGridTextColumn Header="Tên bản vẽ" Width="*"
                                                    Binding="{Binding SheetTitle}"/>
                                <DataGridTextColumn Header="Kích thước" Width="105"
                                                    Binding="{Binding Dimensions}"/>
                                <DataGridTextColumn Header="Chiều in" Width="75"
                                                    Binding="{Binding OrientationText}"/>
                                <DataGridTextColumn Header="Trạng thái" Width="75"
                                                    Binding="{Binding Status}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: PRESETS -->
            <TabItem Header="Cấu hình mẫu (Presets)">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="4" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource Text.Section}" Text="Danh sách cấu hình đã lưu"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                     DisplayMemberPath="Name" Margin="0,8"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Áp dụng" Style="{StaticResource Button.Primary}" Command="{Binding ApplyPresetCommand}"/>
                                <Button Content="Xóa" Command="{Binding DeletePresetAsyncCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="4" Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Text="Lưu cấu hình hiện tại thành mẫu mới"/>
                            <TextBlock Text="Cấu hình bao gồm: loại khung, máy in, khổ giấy, nét in, chiều in, thư mục xuất và mẫu đặt tên."
                                       Style="{StaticResource Text.Muted}" Margin="0,4,0,16"/>
                            <TextBox Text="{Binding PresetNameInput, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="Tên cấu hình mẫu mới (vd: A1 Full Bleed - Monochrome)"
                                     Margin="{DynamicResource Margin.Section}"/>
                            <Button Content="Lưu cấu hình" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left"
                                    Command="{Binding SavePresetAsyncCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: SETTINGS -->
            <TabItem Header="Cài đặt (Settings)">
                <Grid Margin="0,16,0,0">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="4" Padding="16" MaxWidth="640" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Text="Thuật toán sắp xếp không gian (Spatial Sorting)"/>
                            <TextBlock Text="Độ dung sai nhóm hàng dọc (Tolerance Overlap Band Ratio):" Margin="0,8,0,4"/>
                            <Grid Margin="{DynamicResource Margin.Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0.1" Maximum="0.9" SmallChange="0.05" LargeChange="0.1"
                                        Value="{Binding ToleranceBandYRatio}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ToleranceBandYRatio, StringFormat='{}{0:P0}'}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                            <TextBlock Text="Dung sai 50% cho phép gom các khung zic-zac hoặc lệch cốt vào cùng một hàng Top-Down để in đúng thứ tự đọc."
                                       Style="{StaticResource Text.Muted}" Margin="0,0,0,16"/>

                            <TextBlock Style="{StaticResource Text.Section}" Text="Cú pháp mẫu đặt tên file (Naming Tokens)"/>
                            <TextBlock Text="• {Prefix}: Tiền tố file (cấu hình ở trang In ấn)" Margin="0,2"/>
                            <TextBlock Text="• {Layout}: Tên layout chứa khung (Model hoặc tên PaperSpace)" Margin="0,2"/>
                            <TextBlock Text="• {SheetNo}: Số hiệu bản vẽ trích xuất từ Attribute" Margin="0,2"/>
                            <TextBlock Text="• {Title}: Tiêu đề bản vẽ trích xuất từ Attribute" Margin="0,2"/>
                            <TextBlock Text="• {Order}: Số thứ tự của bản vẽ sau khi gom và sắp xếp" Margin="0,2"/>
                            <TextBlock Text="• {DwgName}: Tên file bản vẽ hiện tại" Margin="0,2"/>
                            <TextBlock Text="• {Date}: Ngày xuất bản theo định dạng yyyyMMdd" Margin="0,2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: ABOUT -->
            <TabItem Header="Giới thiệu (About)">
                <Grid Margin="0,16,0,0">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="4" Padding="20" MaxWidth="600" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="HPAutoCad Smart Plot Pro" Style="{StaticResource Text.Title}" FontSize="18"/>
                            <TextBlock Text="Phiên bản 1.0 · Kiến trúc .NET 8 (AutoCAD 2026)" Style="{StaticResource Text.Muted}" Margin="0,4,0,16"/>
                            <TextBlock Text="Smart Plot Pro là công cụ tự động nhận diện khung in, tối ưu hóa thứ tự bản vẽ và xuất bản PDF hàng loạt cho AutoCAD."
                                       Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBlock Text="• Hỗ trợ nhận diện Block khung tên (bao gồm Dynamic Block và Attributes), Polyline khép kín và Layouts."
                                       Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="• Tự động nhận diện hướng khổ giấy (Landscape/Portrait), căn giữa và fit trang."
                                       Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="• Gộp nhiều bản vẽ thành 1 file PDF duy nhất bằng engine PDFsharp tích hợp in-process."
                                       Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="• Đồng bộ giao diện Dark/Light mode tự động theo AutoCAD (COLORTHEME)."
                                       Margin="0,0,0,16" TextWrapping="Wrap"/>
                            <TextBlock Text="© HP Ecosystem. All rights reserved." Style="{StaticResource Text.Muted}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 4. Footer Action Bar -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}"
                       VerticalAlignment="Center" MaxWidth="400" TextTrimming="CharacterEllipsis"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Quét khung" Style="{StaticResource Button.Primary}"
                        Command="{Binding ScanFramesCommand}"/>
                <Button Content="In đã chọn" Style="{StaticResource Button.Primary}"
                        Command="{Binding PlotSelectedCommand}"/>
                <Button Content="In tất cả"
                        Command="{Binding PlotAllCommand}"/>
                <Button Content="Đóng"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
