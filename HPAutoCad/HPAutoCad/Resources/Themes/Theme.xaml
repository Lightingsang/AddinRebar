<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Styles only, based on the MaterialDesign toolkit merged first; every colour comes from the Dark/Light dictionary
         the theme bridge swaps in at run time (DynamicResource), so the dialog follows AutoCAD's COLORTHEME.
         Spacing tokens: 4 / 8 / 16. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HPAutoCad;component/Resources/Themes/MaterialBridge.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <sys:Double x:Key="Spacing.XS">4</sys:Double>
    <sys:Double x:Key="Spacing.S">8</sys:Double>
    <sys:Double x:Key="Spacing.M">16</sys:Double>
    <Thickness x:Key="Padding.Control">8,4</Thickness>
    <Thickness x:Key="Margin.Row">0,0,0,8</Thickness>
    <Thickness x:Key="Margin.Section">0,0,0,16</Thickness>

    <!-- No implicit Window style: WPF only applies one to the exact type, never to a derived window, so the
         window sets its own Background/Foreground in XAML. -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- TextBox and ComboBox keep the toolkit's implicit styles: underlined fields whose popup and editor follow the theme. -->

    <Style TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignRadioButton}">
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Compact header: the toolkit's 24 px header inset and 15 px header font would misalign the row with the fields above. -->
    <Style TargetType="Expander" BasedOn="{StaticResource MaterialDesignExpander}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Margin" Value="{DynamicResource Margin.Row}"/>
        <Setter Property="md:ExpanderAssist.HorizontalHeaderPadding" Value="0,6"/>
        <Setter Property="md:ExpanderAssist.HeaderFontSize" Value="12"/>
    </Style>

    <!-- The toolkit's DataGrid style names its own cell / header styles, so ours are keyed and handed to it below. -->
    <Style x:Key="DataGrid.ColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DataGrid.Cell" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="Background" Value="{DynamicResource Brush.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="RowBackground" Value="{DynamicResource Brush.Input}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGrid.ColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource DataGrid.Cell}"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Single"/>
    </Style>
</ResourceDictionary>
