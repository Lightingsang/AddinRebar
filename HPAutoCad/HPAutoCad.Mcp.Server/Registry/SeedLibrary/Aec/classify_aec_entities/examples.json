        "1A2C",
        "1A2D"
      ],
      "includeUnknown": true,
      "minConfidence": 0
    }
  },
  {
    "title": "Doors and windows with the default rule set, explicitly",
    "args": {
      "filter": {
        "types": [
          "INSERT",
          "ARC"
        ]
      },
      "disciplines": [
        "Architecture"
      ],
      "ruleSet": "default"
    }
  }
]
