<?xml version="1.0" encoding="utf-8"?>
<!--
  Autodesk autoloader manifest. Deployed by the DeployBundle target to
    %AppData%\Autodesk\ApplicationPlugins\HPAutoCad.McpBridge.bundle\
  with Contents\HPAutoCad.McpBridge.Loader.dll (the assembly AutoCAD loads) and Contents\Bridge\*
  (the real bridge, loaded by the loader into its own AssemblyLoadContext).

  SeriesMin/Max are AutoCAD's internal release numbers, not years: AutoCAD 2026 = R25.1.
  Platform="AutoCAD" (not "AutoCAD*") keeps the bundle out of Civil 3D / Advance Steel 2026, which share
  R25.1 and would otherwise race for the same named pipe.
-->
<ApplicationPackage SchemaVersion="1.0"
                    AutodeskProduct="AutoCAD"
                    ProductType="Application"
                    Name="HPAutoCad MCP Bridge"
                    AppVersion="0.3.0"
                    Description="MCP bridge: AI-generated C# runs inside AutoCAD after the user opts in"
                    ProductCode="{7B4E9C2D-5A61-4F0E-9D3B-2C8F1E6A7D54}">
  <CompanyDetails Name="HPRebar" />
  <Components Description="AutoCAD 2026 (.NET 8)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD" SeriesMin="R25.1" SeriesMax="R25.1" />
    <ComponentEntry AppName="HPAutoCad.McpBridge"
                    Version="0.3.0"
                    ModuleName="./Contents/HPAutoCad.McpBridge.Loader.dll"
                    AppType=".NET"
                    LoadOnAutoCADStartup="True" />
  </Components>
</ApplicationPackage>
