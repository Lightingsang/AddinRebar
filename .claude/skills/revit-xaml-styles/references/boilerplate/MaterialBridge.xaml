<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--
        MaterialBridge.xaml — Cầu nối MaterialDesignInXamlToolkit cho Add-in CAD/BIM
        Merged đầu tiên trong Theme.xaml để các control nhận style Material Design mặc định.
        Màu sắc được MaterialThemeBridge đồng bộ tự động theo Dark/Light của host runtime.

        Chỉ chứa phần nền. KHÔNG định nghĩa style bọc lại (PrimaryButton, StandardTextBox, Card.Panel…):
        XAML gọi thẳng key của toolkit (MaterialDesignRaisedButton, MaterialDesignOutlinedTextBox, md:Card…),
        màu riêng lấy từ token HP {DynamicResource Brush.*}.
    -->
    <ResourceDictionary.MergedDictionaries>
        <md:CustomColorTheme BaseTheme="Dark" PrimaryColor="#0696D7" SecondaryColor="#E0641E"/>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        QUY TẮC BẮT BUỘC: Ghi đè Font Segoe UI khắp nơi.
        CẤM dùng {md:MaterialDesignFont} (Roboto) vì Pack URI của Roboto không thể resolve sau khi ILRepack merge,
        gây crash hoặc lỗi hiển thị. Segoe UI là font hệ thống chuẩn của Windows, Revit và AutoCAD.
    -->
    <FontFamily x:Key="MaterialDesignFont">Segoe UI</FontFamily>
</ResourceDictionary>
