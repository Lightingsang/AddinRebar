<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- netstandard2.0 for the net8/net10 hosts (unchanged asset); net48 for the Navisworks bridge. The System.Text.Json
             package ships assembly version 10.0.0.0 in lib/netstandard2.0 but 10.0.0.12 in lib/net462, and .NET Framework binds
             by exact version with no redirects inside a plugin, so a net48 consumer must get a Contracts compiled against
             the net462 asset or Roamer.exe cannot even reflect over the plugin's types. -->
        <TargetFrameworks>netstandard2.0;net48</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>HPRebar.Mcp.Contracts</RootNamespace>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <!-- Shared by the net10 server and the net8 bridge; netstandard2.0 is the common floor -->
        <PackageReference Include="System.Text.Json" Version="10.0.12"/>
        <!-- record / init / required on netstandard2.0 -->
        <PackageReference Include="Polyfill" Version="11.0.1" PrivateAssets="all"/>
    </ItemGroup>

</Project>
