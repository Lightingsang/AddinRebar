<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Namespaces keep the HPRebar.Mcp.Server.* prefix of the exe this code was extracted from;
             renaming them is a separate cleanup once both MCPs consume this library. -->
        <RootNamespace>HPRebar.Mcp.Server</RootNamespace>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <!-- The half of an MCP server exe that does not know which CAD host it serves: bootstrap, pipe
             client, result formatter, execute/context services, the tool registry engine and its meta
             tools, the toolify prompt and the registry CLI. A host exe adds IHostProfile, its four core
             tool/prompt/resource classes and its embedded seeds. Never references Autodesk.*. -->
        <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
        <InternalsVisibleTo Include="HPRebar.Mcp.Server.Tests" />
        <InternalsVisibleTo Include="HPRebar.Mcp.Server.Core.Tests" />
        <InternalsVisibleTo Include="HPAutoCad.Mcp.Server.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HPRebar.Mcp.Contracts\HPRebar.Mcp.Contracts.csproj" />
    </ItemGroup>

</Project>
