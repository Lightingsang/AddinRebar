<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path="global.json" />
    <File Path="README.md" />
  </Folder>
  <!-- Host-neutral libraries shared by every HP MCP (Revit in HPRebar/, AutoCAD in HPAutoCad/).
       Nothing here may reference Autodesk.* : the host arrives through IHostProfile / IBridgeExecutor. -->
  <Project Path="HPRebar.Mcp.Contracts/HPRebar.Mcp.Contracts.csproj" />
  <Project Path="HPRebar.McpBridge.Core/HPRebar.McpBridge.Core.csproj" />
  <Project Path="HPRebar.Mcp.Server.Core/HPRebar.Mcp.Server.Core.csproj" />
  <Project Path="HPRebar.Mcp.Server.Core.Tests/HPRebar.Mcp.Server.Core.Tests.csproj" />
</Solution>
