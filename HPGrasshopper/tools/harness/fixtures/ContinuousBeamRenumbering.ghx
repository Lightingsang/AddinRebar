                <item name="Name" type_name="gh_string" type_code="10">Panel</item>
                <item name="NickName" type_name="gh_string" type_code="10">RenumberSummary</item>
                <item name="NumericValue" type_name="gh_double" type_code="6">0</item>
                <item name="StringValue" type_name="gh_string" type_code="10">Continuous Beam Renumbering: Ready to execute.</item>
                <item name="TypeTag" type_name="gh_string" type_code="10">Param_String</item>
