<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="HPRebar">
      <HintPath>..\..\HPRebar\HPRebar\bin\Debug.R26\HPRebar.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.0.4" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.0.4" />
  </ItemGroup>
</Project>
