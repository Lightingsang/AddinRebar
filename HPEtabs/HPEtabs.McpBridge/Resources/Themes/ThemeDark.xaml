<!-- Dark palette (the AutoCAD bridge values; accent = the HP product blue). Swapped at run time by MaterialThemeBridge (top-level overlay); keep both files' key sets identical. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Background" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF363636"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#FF4A4A4A"/>
    <SolidColorBrush x:Key="Brush.Foreground.Primary" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="Brush.Foreground.Secondary" Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="Brush.Foreground.Tertiary" Color="#FF7A7A7A"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF0696D7"/>
    <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Info" Color="#FF0696D7"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#FF4CAF50"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFE0A030"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFE05A4F"/>
</ResourceDictionary>
