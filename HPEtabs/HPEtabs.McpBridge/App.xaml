<Application x:Class="HPEtabs.McpBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MaterialDesign first; the palette and the token dictionary below keep the last word. -->
                <ResourceDictionary Source="/HPEtabs.McpBridge;component/Resources/Themes/MaterialBridge.xaml"/>
                <ResourceDictionary Source="/HPEtabs.McpBridge;component/Resources/Themes/ThemeLight.xaml"/>
                <ResourceDictionary Source="/HPEtabs.McpBridge;component/Resources/Themes/EtabsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
