<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Pure tests of the host-free engine: golden fixtures generated from the reference tool (forward) and
             proj4 (reverse), catalogue counts, validation, KML/KMZ, and the dialog's view model. net10.0-windows only
             because HPGeo.AutoCad is net8.0-windows (WPF, compiled against the AutoCAD API); the view model never
             touches an AutoCAD type, so acad.exe is not needed. -->
        <TargetFramework>net10.0-windows</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>HPGeo.Tests</RootNamespace>
        <Configurations>Debug;Release</Configurations>
        <IsPackable>false</IsPackable>
        <!-- global.json pins test.runner = Microsoft.Testing.Platform; xunit.v3 speaks it natively -->
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.1.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HPGeo.Core\HPGeo.Core.csproj"/>
        <ProjectReference Include="..\HPGeo.AutoCad\HPGeo.AutoCad.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
