<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- AutoCAD COLORTHEME 0 (dark): the palette of its own dialogs. -->
    <SolidColorBrush x:Key="Brush.Background" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#353535"/>
    <SolidColorBrush x:Key="Brush.Input" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#0696D7"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#F06A6A"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#E0B341"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#5FBF7A"/>
</ResourceDictionary>
