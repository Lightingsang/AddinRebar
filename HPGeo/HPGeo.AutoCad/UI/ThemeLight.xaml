<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- AutoCAD COLORTHEME 1 (light). -->
    <SolidColorBrush x:Key="Brush.Background" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#0696D7"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#C62828"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#B26A00"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#2E7D32"/>
    <!-- Names the theme bridge reads (the shared helper's vocabulary) = Brush.Text / Brush.TextMuted / Brush.Surface. Kept as
         plain brushes: a StaticResource alias inside compiled BAML resolves to the wrong entry (deferred-load bug). -->
    <SolidColorBrush x:Key="Brush.Foreground.Primary" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush.Foreground.Secondary" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#E8E8E8"/>
</ResourceDictionary>
