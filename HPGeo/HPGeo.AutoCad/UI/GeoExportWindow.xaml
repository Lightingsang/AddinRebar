<Window x:Class="HPGeo.AutoCad.UI.GeoExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HPGeo.AutoCad.UI"
        Title="HPGeo · VN-2000 → KMZ"
        Width="1040" Height="720" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Source -->
        <DockPanel Grid.Row="0" Margin="{DynamicResource Margin.Section}">
            <TextBlock Style="{StaticResource Text.Title}" Text="VN-2000 → WGS84 → KMZ" DockPanel.Dock="Left"/>
            <TextBlock Style="{StaticResource Text.Muted}" Margin="16,0,0,0" Text="{Binding SourceSummary}" DockPanel.Dock="Left"/>
        </DockPanel>

        <!-- Coordinate system (shared block) -->
        <vm:CrsSelectionView Grid.Row="1" Margin="{DynamicResource Margin.Section}" DataContext="{Binding Crs}"/>

        <!-- Output -->
        <Grid Grid.Row="2" Margin="{DynamicResource Margin.Section}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Text.Section}" Text="Xuất KMZ"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Nội dung"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="{DynamicResource Margin.Row}">
                <RadioButton Content="Điểm + Ranh" IsChecked="{Binding OutputBoth}"/>
                <RadioButton Content="Chỉ điểm" IsChecked="{Binding OutputPoints}"/>
                <RadioButton Content="Chỉ ranh" IsChecked="{Binding OutputBoundaries}"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tên file / màu"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="220" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tên file KMZ và tên tài liệu trong Google Earth"/>
                <TextBlock Text="Màu điểm" Margin="16,0,4,0"/>
                <TextBox Width="80" Text="{Binding PointColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="aabbggrr — vd ff00ffff = vàng"/>
                <TextBlock Text="Màu ranh" Margin="12,0,4,0"/>
                <TextBox Width="80" Text="{Binding LineColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="aabbggrr — vd ff0000ff = đỏ"/>
            </StackPanel>
        </Grid>

        <!-- Preview: table + map -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="340" MinWidth="200"/>
                </Grid.ColumnDefinitions>
                <DataGrid Grid.Column="0" ItemsSource="{Binding Preview}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="52"/>
                        <DataGridTextColumn Header="E (m)" Binding="{Binding Easting}" Width="92"/>
                        <DataGridTextColumn Header="N (m)" Binding="{Binding Northing}" Width="96"/>
                        <DataGridTextColumn Header="Lat" Binding="{Binding Lat}" Width="88"/>
                        <DataGridTextColumn Header="Lon" Binding="{Binding Lon}" Width="94"/>
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                <vm:MapPanel Grid.Column="2" x:Name="MapView" Data="{Binding MapDataJson}"/>
            </Grid>
            <TextBox Grid.Row="1" Height="160" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     Text="{Binding KmlPreview, Mode=OneWay}"
                     Visibility="{Binding ShowKmlPreview, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
        </Grid>

        <!-- Issues + status -->
        <StackPanel Grid.Row="4" Margin="0,8,0,8">
            <TextBlock Text="{Binding IssuesText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}"
                       Visibility="{Binding IssuesText, Converter={x:Static vm:NonEmptyToVisibilityConverter.Instance}}"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Xem KML" Command="{Binding ToggleKmlPreviewCommand}"/>
            <Button Content="Xuất KMZ…" Style="{StaticResource Button.Primary}" Command="{Binding ExportKmzCommand}" IsEnabled="{Binding CanExport}"/>
            <Button Content="Mở Google Earth" Command="{Binding OpenGoogleEarthCommand}" IsEnabled="{Binding CanExport}"/>
            <Button Content="Google Maps" Command="{Binding OpenGoogleMapsCommand}" IsEnabled="{Binding CanExport}"/>
            <Button Content="Đóng" Command="{Binding CloseCommand}" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
