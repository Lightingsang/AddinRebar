<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Host-free engine: VN-2000 <-> WGS84 (TM-3 + 7-parameter Helmert), the province catalogue and the KML/KMZ
             writer. Never references an AutoCAD type so it is unit-tested without acad.exe. -->
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>HPGeo.Core</RootNamespace>
        <Configurations>Debug;Release</Configurations>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- Generated by tools/extract-province-data.js from the reference HTML tool; never edited by hand. -->
        <EmbeddedResource Include="Data\vn2000-provinces.json" LogicalName="HPGeo.Core.Data.vn2000-provinces.json"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HPGeo.Tests"/>
    </ItemGroup>

</Project>
