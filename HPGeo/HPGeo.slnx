  <Project Path="HPGeo.AutoCad/HPGeo.AutoCad.csproj" />
  <Project Path="HPGeo.AutoCad.Loader/HPGeo.AutoCad.Loader.csproj" />
  <Project Path="HPGeo.TileFetch/HPGeo.TileFetch.csproj" />
  <Project Path="HPGeo.Tests/HPGeo.Tests.csproj" />
</Solution>
