<mah:MetroWindow x:Class="HPDcePro.UI.Views.CocBtWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  xmlns:vm="clr-namespace:HPDcePro.UI.ViewModels"
                  Title="HPDcePro - Thiết Kế Sức Chịu Tải Cọc Bê Tông (CocBT_Frm)"
                  Height="660" Width="900"
                  MinHeight="550" MinWidth="750"
                  WindowStartupLocation="CenterScreen"
                  GlowBrush="{DynamicResource Brush.Accent}"
                  BorderThickness="1"
                  TitleCharacterCasing="Normal">

    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPDcePro.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card.Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="TÍNH TOÁN SỨC CHỊU TẢI CỌC ĐƠN THEO TCVN 10304:2025" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="Đánh giá sức kháng mũi Rb, sức kháng thân Rs và sức chịu tải thiết kế Rc theo chỉ số SPT N60" Style="{StaticResource Text.Muted}"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="12,6" CornerRadius="4" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusSummary}" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Inputs -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="1. Tiết diện &amp; Chiều sâu cọc" Style="{StaticResource GroupBox.Header}">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ký hiệu cọc:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PileMark}" Style="{StaticResource StandardTextBox}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Kích thước cạnh/D (mm):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DimensionMm}" Style="{StaticResource StandardTextBox}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Chiều sâu mũi cọc L (m):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TipDepthM}" Style="{StaticResource StandardTextBox}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Chỉ số SPT mũi N60:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TipSoilN60}" Style="{StaticResource StandardTextBox}"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Outputs -->
            <Border Grid.Column="2" Style="{StaticResource Card.Panel}">
                <StackPanel>
                    <TextBlock Text="KẾT QUẢ SỨC CHỊU TẢI CỌC" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sức kháng mũi Rb (kN):" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TipCapacityRbKn, StringFormat='{}{0:F1}'}" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sức kháng thân Rs (kN):" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ShaftCapacityRsKn, StringFormat='{}{0:F1}'}" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sức chịu tải cực hạn Ru (kN):" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding UltimateCapacityRuKn, StringFormat='{}{0:F1}'}" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sức chịu tải thiết kế Rc (kN):" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DesignCapacityRcKn, StringFormat='{}{0:F1}'}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Actions -->
        <Border Grid.Row="2" Style="{StaticResource Card.Panel}">
            <DockPanel LastChildFill="False">
                <Button Content="Tính toán" Command="{Binding CalculateCapacityCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Left"/>
                <Button Content="Đóng" Click="CloseButton_Click" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
