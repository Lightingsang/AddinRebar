<mah:MetroWindow x:Class="HPDcePro.UI.Views.CuttingOptimizationWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:vm="clr-namespace:HPDcePro.UI.ViewModels"
                 Title="HPDcePro - Tối Ưu Cắt Thép Thương Phẩm 11.7m (ToiUuCatThep)"
                 Height="700" Width="1000"
                 MinHeight="550" MinWidth="800"
                 WindowStartupLocation="CenterScreen"
                 GlowBrush="{DynamicResource Brush.Accent}"
                 BorderThickness="1"
                 TitleCharacterCasing="Normal">

    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPDcePro.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Configuration Bar -->
        <Border Grid.Row="0" Style="{StaticResource Card.Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Đường kính (mm):" Style="{StaticResource Text.Label}" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDiameters}" SelectedItem="{Binding SelectedDiameter}"/>

                <TextBlock Grid.Column="3" Text="Chiều dài cây (mm):" Style="{StaticResource Text.Label}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="4" Text="{Binding StockLengthMm}"/>

                <TextBlock Grid.Column="6" Text="Thuật toán:" Style="{StaticResource Text.Label}" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="7" ItemsSource="{Binding AvailableStrategies}" SelectedItem="{Binding SelectedStrategy}"/>

                <StackPanel Grid.Column="9" Orientation="Horizontal">
                    <Button Content="Thêm Đoạn" Command="{Binding AddDemandCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Tải Mẫu" Command="{Binding LoadSampleDemandsCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Grids -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Demands List -->
            <GroupBox Grid.Column="0" Header="Nhu cầu cắt thép (Danh sách thanh)" Style="{StaticResource GroupBox.Header}">
                <DataGrid ItemsSource="{Binding Demands}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã hiệu" Binding="{Binding Id}" Width="1.2*"/>
                        <DataGridTextColumn Header="ĐK (mm)" Binding="{Binding DiameterMm}" Width="70"/>
                        <DataGridTextColumn Header="Dài L (mm)" Binding="{Binding LengthMm}" Width="90"/>
                        <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Cutting Patterns -->
            <GroupBox Grid.Column="2" Header="Kết quả sơ đồ cắt (Patterns)" Style="{StaticResource GroupBox.Header}">
                <DataGrid ItemsSource="{Binding ResultPatterns}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cây #" Binding="{Binding StockBarIndex}" Width="60"/>
                        <DataGridTextColumn Header="Dùng (mm)" Binding="{Binding UsedLengthMm, StringFormat={}{0:F0}}" Width="90"/>
                        <DataGridTextColumn Header="Thừa (mm)" Binding="{Binding RemnantLengthMm, StringFormat={}{0:F0}}" Width="90"/>
                        <DataGridCheckBoxColumn Header="Tái sử dụng" Binding="{Binding IsReusableRemnant}" Width="90"/>
                        <DataGridTextColumn Header="Số nhát cắt" Binding="{Binding Cuts.Count}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- Metrics Summary -->
        <Border Grid.Row="2" Style="{StaticResource Card.Panel}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Tổng số cây nguyên 11.7m: " Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding TotalStockBarsUsed}" Style="{StaticResource Text.Bold}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Tỷ lệ phế liệu không thu hồi: " Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding ScrapPercentage, StringFormat={}{0:F2}%}" Style="{StaticResource Text.Bold}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Tổng tỷ lệ đầu mẩu thừa: " Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding TotalWastePercentage, StringFormat={}{0:F2}%}" Style="{StaticResource Text.Bold}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Chạy Tối Ưu Cắt" Command="{Binding OptimizeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="Đóng" Click="CloseButton_Click" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
