<mah:MetroWindow x:Class="HPDcePro.UI.Views.MongCocChonThepTuDongWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  xmlns:vm="clr-namespace:HPDcePro.UI.ViewModels"
                  Title="HPDcePro - Chọn Thép Tự Động Đài Móng (MongCoc_FrmChonThepTuDong)"
                  Height="560" Width="800"
                  MinHeight="450" MinWidth="650"
                  WindowStartupLocation="CenterOwner"
                  GlowBrush="{DynamicResource Brush.Accent}"
                  BorderThickness="1"
                  TitleCharacterCasing="Normal">

    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPDcePro.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card.Panel}">
            <StackPanel>
                <TextBlock Text="TỰ ĐỘNG TỐI ƯU HÓA BỐ TRÍ THÉP ĐÀI CỌC" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="Tìm kiếm các phương án đường kính và khoảng cách rải thép tiệm cận diện tích yêu cầu với khối lượng nhỏ nhất" Style="{StaticResource Text.Muted}"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Border Style="{StaticResource Card.Panel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Diện tích As yêu cầu: " VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RequiredAsXMm2, StringFormat='{}{0:F0} mm²'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Content="Tìm lại" Command="{Binding SearchOptimalConfigurationsCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding Candidates}" Style="{StaticResource StandardDataGrid}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Đường kính" Binding="{Binding DiameterMm, StringFormat='{}Φ{0}'}" Width="*"/>
                            <DataGridTextColumn Header="Khoảng rải a" Binding="{Binding SpacingMm, StringFormat='{}a{0:F0}'}" Width="*"/>
                            <DataGridTextColumn Header="Số thanh" Binding="{Binding BarCount}" Width="*"/>
                            <DataGridTextColumn Header="As bố trí (mm²)" Binding="{Binding ProvidedAsMm2, StringFormat='{}{0:F1}'}" Width="1.2*"/>
                            <DataGridTextColumn Header="Tỉ số As/As,yc" Binding="{Binding Ratio, StringFormat='{}{0:F2}'}" Width="1.1*"/>
                            <DataGridCheckBoxColumn Header="Đạt" Binding="{Binding IsSafe}" Width="0.8*"/>
                            <DataGridTextColumn Header="Khối lượng (kg)" Binding="{Binding SteelWeightKg, StringFormat='{}{0:F1}'}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Actions -->
        <Border Grid.Row="2" Style="{StaticResource Card.Panel}">
            <DockPanel LastChildFill="False">
                <Button Content="Chọn phương án" Click="CloseButton_Click" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"/>
                <Button Content="Đóng" Click="CloseButton_Click" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
