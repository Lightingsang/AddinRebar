<mah:MetroWindow x:Class="HPDcePro.UI.Views.ThangMoiWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  xmlns:vm="clr-namespace:HPDcePro.UI.ViewModels"
                  Title="HPDcePro - Thiết Kế Cầu Thang BTCT (ThangMoi_Frm)"
                  Height="680" Width="920"
                  MinHeight="550" MinWidth="750"
                  WindowStartupLocation="CenterScreen"
                  GlowBrush="{DynamicResource Brush.Accent}"
                  BorderThickness="1"
                  TitleCharacterCasing="Normal">

    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPDcePro.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card.Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="THIẾT KẾ &amp; CHI TIẾT CẦU THANG BTCT" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="Tính toán bản thang dạng bản lượn hoặc dích dắc, kiểm tra công thức Blondel và bố trí thép" Style="{StaticResource Text.Muted}"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="12,6" CornerRadius="4" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusSummary}" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Inputs -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="1. Hình học bậc &amp; Chiều cao" Style="{StaticResource GroupBox.Header}">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ký hiệu thang:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StairMark}" Style="{StaticResource StandardTextBox}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Chiều dài nhịp L (mm):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FlightSpanLMm}" Style="{StaticResource StandardTextBox}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Chiều cao đợt H (mm):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TotalRiseHMm}" Style="{StaticResource StandardTextBox}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Số bậc thang:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NumberOfSteps}" Style="{StaticResource StandardTextBox}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Chiều dày bản h (mm):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding WaistThicknessHMm}" Style="{StaticResource StandardTextBox}"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Outputs -->
            <Border Grid.Column="2" Style="{StaticResource Card.Panel}">
                <StackPanel>
                    <TextBlock Text="KẾT QUẢ TÍNH TOÁN CẦU THANG" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Chiều cao bậc h_b (mm):" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding RiserHeightMm, StringFormat='{}{0:F1}'}" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bề rộng bậc b_b (mm):" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TreadWidthMm, StringFormat='{}{0:F1}'}" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Kiểm tra Blondel (2h+b):" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding BlondelValue, StringFormat='{}{0:F0} mm'}" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Góc nghiêng bản thang (°):" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding InclineAngleDeg, StringFormat='{}{0:F1}°'}" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mô men tính toán (kNm):" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MaxDesignMomentKnm, StringFormat='{}{0:F2}'}" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Thép chủ As (mm²):" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding RequiredMainAsMm2, StringFormat='{}{0:F1}'}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Actions -->
        <Border Grid.Row="2" Style="{StaticResource Card.Panel}">
            <DockPanel LastChildFill="False">
                <Button Content="Tính toán" Command="{Binding CalculateCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Left"/>
                <Button Content="Đóng" Click="CloseButton_Click" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
