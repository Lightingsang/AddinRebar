<mah:MetroWindow x:Class="HPDcePro.UI.Views.ColumnWallDetailingWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  Title="HPDcePro - Thiết Kế &amp; Chi Tiết Cột / Vách BTCT (TCVN 5574:2018)"
                  Height="720" Width="960" MinHeight="600" MinWidth="800"
                  WindowStartupLocation="CenterScreen"
                  GlowBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                  TitleCharacterCasing="Normal">

    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPDcePro.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card.Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="THIẾT KẾ &amp; CHI TIẾT CỘT / VÁCH BTCT (TCVN 5574:2018)" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="Biểu đồ tương tác N-Mx-My phi tuyến, độ mảnh uốn dọc và bố trí thép cấu tạo vách cứng" Style="{StaticResource Text.Muted}"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="12,6" CornerRadius="4" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Tabs -->
        <mah:MetroAnimatedTabControl Grid.Row="1" Margin="0,8,0,8">
            <!-- TAB 1: COLUMN P-M-M -->
            <TabItem Header="1. CỘT BTCT (BIAXIAL P-M-M)">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Column Inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="1. Tiết diện &amp; Chiều dài cột" Style="{StaticResource GroupBox.Header}">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Rộng b (mm)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding WidthBMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Cao h (mm)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding HeightHMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Chiều dài l0 (mm)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding LengthL0Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="2. Tải trọng tính toán" Style="{StaticResource GroupBox.Header}">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Đúng tâm N (kN)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding DesignAxialNKn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Momen Mx (kNm)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding DesignMomentMxKnm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Momen My (kNm)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding DesignMomentMyKnm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="3. Cốt thép bố trí" Style="{StaticResource GroupBox.Header}">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Thép góc (đk mm)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding CornerBarDiameter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Thép cạnh (đk mm)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SideBarDiameter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right: Column Results -->
                    <Border Grid.Column="2" Style="{StaticResource Card.Panel}">
                        <StackPanel>
                            <TextBlock Text="KẾT QUẢ TÍNH TOÁN P-M-M" Style="{StaticResource Text.Section}"/>
                            <Separator Margin="0,4,0,12"/>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hệ số uốn dọc etaX:" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SlendernessEtaX, StringFormat={}{0:F2}}" Style="{StaticResource Text.Bold}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hệ số uốn dọc etaY:" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SlendernessEtaY, StringFormat={}{0:F2}}" Style="{StaticResource Text.Bold}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Momen tính toán Mxd:" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MagnifiedMxd, StringFormat={}{0:F1} kNm}" Style="{StaticResource Text.Bold}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Momen tính toán Myd:" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MagnifiedMyd, StringFormat={}{0:F1} kNm}" Style="{StaticResource Text.Bold}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Khả năng chịu nén N0:" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding AxialCapacityN0, StringFormat={}{0:F1} kN}" Style="{StaticResource Text.Bold}"/>
                            </Grid>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hệ số sử dụng (UR):" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding UtilizationRatio, StringFormat={}{0:P1}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                            </Grid>
                            <Button Content="Tính toán P-M-M" Command="{Binding CalculatePmmCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: SHEAR WALL -->
            <TabItem Header="2. VÁCH CỨNG (SHEAR WALL)">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Wall Inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="1. Kích thước hình học vách" Style="{StaticResource GroupBox.Header}">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Chiều dài Lw (mm)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding WallLengthLwMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Bề dày Tw (mm)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding WallThicknessTwMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="2. Nội lực vách" Style="{StaticResource GroupBox.Header}">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Lực cắt Vu (kN)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding WallDesignShearVuKn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Lực nén N (kN)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding WallDesignAxialNKn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBox}"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right: Wall Results -->
                    <Border Grid.Column="2" Style="{StaticResource Card.Panel}">
                        <StackPanel>
                            <TextBlock Text="KẾT QUẢ KIỂM TRA VÁCH" Style="{StaticResource Text.Section}"/>
                            <Separator Margin="0,4,0,12"/>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cột đầu vách Lc:" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding BoundaryLengthLc, StringFormat={}{0:F0} mm}" Style="{StaticResource Text.Bold}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hàm lượng thép đầu vách:" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding BoundaryRebarRatio, StringFormat={}{0:F2} %}" Style="{StaticResource Text.Bold}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Khả năng chịu cắt VuMax:" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding WebShearCapacity, StringFormat={}{0:F1} kN}" Style="{StaticResource Text.Bold}"/>
                            </Grid>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tỷ số cắt (Vu/VuMax):" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ShearUtilizationRatio, StringFormat={}{0:P1}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                            </Grid>
                            <Button Content="Tính toán Vách" Command="{Binding CalculateWallCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </mah:MetroAnimatedTabControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Padding="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Xuất bản vẽ CAD" Command="{Binding ExportCadCommand}" Style="{StaticResource SecondaryButton}" Width="150" Margin="0,0,8,0"/>
                <Button Content="Đóng" Click="CloseButton_Click" Style="{StaticResource PrimaryButton}" Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
