<mah:MetroWindow x:Class="HPDcePro.UI.Views.BeamDetailingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:vm="clr-namespace:HPDcePro.UI.ViewModels"
                 Title="HPDcePro - Thiết Kế &amp; Chi Tiết Dầm BTCT (TCVN 5574:2018)"
                 Height="720" Width="960"
                 MinHeight="600" MinWidth="800"
                 WindowStartupLocation="CenterScreen"
                 GlowBrush="{DynamicResource Brush.Accent}"
                 BorderThickness="1"
                 TitleCharacterCasing="Normal">

    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPDcePro.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card.Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CẤU HÌNH DẦM VÀ BỐ TRÍ THÉP TCVN 5574:2018" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="Tính toán kiểm tra khả năng chịu uốn, cắt và hàm lượng thép theo thời gian thực" Style="{StaticResource Text.Muted}"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="12,6" CornerRadius="4"
                        Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverallStatus}" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Inputs -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Geometry & Material -->
                    <GroupBox Header="1. Tiết diện &amp; Vật liệu" Style="{StaticResource GroupBox.Header}">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="{StaticResource Margin.Row}">
                                <TextBlock Text="Bề rộng b (mm)" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="{StaticResource Margin.Row}">
                                <TextBlock Text="Chiều cao h (mm)" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4" Margin="{StaticResource Margin.Row}">
                                <TextBlock Text="Chiều dài L (mm)" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding LengthMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Mác Bê tông" Style="{StaticResource Text.Label}"/>
                                <ComboBox ItemsSource="{Binding AvailableConcretes}" SelectedItem="{Binding SelectedConcrete}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Cấp Cốt thép" Style="{StaticResource Text.Label}"/>
                                <ComboBox ItemsSource="{Binding AvailableRebars}" SelectedItem="{Binding SelectedRebar}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Rebar Arrangement -->
                    <GroupBox Header="2. Bố trí Cốt thép dọc" Style="{StaticResource GroupBox.Header}">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="{StaticResource Margin.Row}">
                                <TextBlock Text="Thép chủ trên (Số thanh x D)" Style="{StaticResource Text.Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding TopContinuousCount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="1" Text="d" VerticalAlignment="Center" Margin="4,0"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableDiameters}" SelectedItem="{Binding TopContinuousDiameter}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="{StaticResource Margin.Row}">
                                <TextBlock Text="Thép tăng cường gối trên" Style="{StaticResource Text.Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding TopExtraSupportCount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="1" Text="d" VerticalAlignment="Center" Margin="4,0"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableDiameters}" SelectedItem="{Binding TopExtraSupportDiameter}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Thép chủ dưới (Số thanh x D)" Style="{StaticResource Text.Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding BottomContinuousCount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="1" Text="d" VerticalAlignment="Center" Margin="4,0"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableDiameters}" SelectedItem="{Binding BottomContinuousDiameter}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Thép gia cường nhịp dưới" Style="{StaticResource Text.Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding BottomExtraSpanCount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="1" Text="d" VerticalAlignment="Center" Margin="4,0"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableDiameters}" SelectedItem="{Binding BottomExtraSpanDiameter}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Stirrups & Internal Forces -->
                    <GroupBox Header="3. Cốt đai &amp; Nội lực thiết kế" Style="{StaticResource GroupBox.Header}">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="{StaticResource Margin.Row}">
                                <TextBlock Text="Đường kính đai" Style="{StaticResource Text.Label}"/>
                                <ComboBox ItemsSource="{Binding StirrupDiameters}" SelectedItem="{Binding StirrupDiameter}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="{StaticResource Margin.Row}">
                                <TextBlock Text="Khoảng đai gối (mm)" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding StirrupSpacingSupport, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4" Margin="{StaticResource Margin.Row}">
                                <TextBlock Text="Khoảng đai nhịp (mm)" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding StirrupSpacingSpan, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Momen M_Ed (kNm)" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding DesignMomentKnM, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Lực cắt V_Ed (kN)" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding DesignShearKn, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: Calculation Results -->
            <Border Grid.Column="2" Style="{StaticResource Card.Panel}">
                <StackPanel>
                    <TextBlock Text="KẾT QUẢ KIỂM TRA TCVN 5574:2018" Style="{StaticResource Text.Section}"/>

                    <Border Margin="0,8" Padding="8" Background="{DynamicResource Brush.Input}" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Diện tích thép bố trí:" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding BottomAsMm2, StringFormat='As đáy bố trí = {0:F1} mm²'}"/>
                            <TextBlock Text="{Binding TopAsMm2, StringFormat='As đỉnh bố trí = {0:F1} mm²'}"/>
                            <TextBlock Text="{Binding ReinforcementRatioPercent, StringFormat='Hàm lượng thép mu = {0:F2}% (Quy định: 0.1% ~ 3.0%)'}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8" Padding="8" Background="{DynamicResource Brush.Input}" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Khả năng chịu uốn (M):" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MomentCapacityKnM, StringFormat='M_Rd = {0:F1} kNm'}"/>
                            <TextBlock Text="{Binding DesignMomentKnM, StringFormat='M_Ed = {0:F1} kNm'}"/>
                            <TextBlock Text="{Binding IsFlexurePass, StringFormat='Kiểm tra uốn: {0}'}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8" Padding="8" Background="{DynamicResource Brush.Input}" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Khả năng chịu cắt (V):" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ShearCapacityKn, StringFormat='V_Rd = {0:F1} kN'}"/>
                            <TextBlock Text="{Binding DesignShearKn, StringFormat='V_Ed = {0:F1} kN'}"/>
                            <TextBlock Text="{Binding IsShearPass, StringFormat='Kiểm tra cắt: {0}'}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Kiểm Tra Lại" Command="{Binding UpdateCalculationsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Đóng" Click="CloseButton_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
