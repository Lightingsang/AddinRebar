<Window x:Class="HPTekla.McpBridge.Views.BridgeStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HPTekla.McpBridge.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BridgeStatusViewModel}"
        Title="HPTekla MCP Bridge — Tekla Structures 2025.0"
        Width="600" Height="720"
        MinWidth="520" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource Font.Family.Default}"
        FontSize="{DynamicResource Font.Size.Body}"
        Foreground="{DynamicResource Brush.Foreground.Primary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HPTekla.McpBridge;component/Resources/Themes/TeklaTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="StatusDot" TargetType="Ellipse">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Fill" Value="{DynamicResource Brush.Foreground.Tertiary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Core.StatusKind}" Value="Listening">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Info}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Core.StatusKind}" Value="Connected">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Core.StatusKind}" Value="Busy">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Core.StatusKind}" Value="Error">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource Spacing.Medium}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header: Pipe Status & Listener Toggle -->
        <Border Grid.Row="0" Style="{DynamicResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Style="{DynamicResource StatusDot}" Margin="{DynamicResource Spacing.SmallHorizontal}"/>

                <StackPanel Grid.Column="1" Margin="{DynamicResource Spacing.SmallHorizontal}">
                    <TextBlock Style="{DynamicResource Subheading}" Text="{Binding Core.StatusText}" TextWrapping="Wrap"/>
                    <TextBlock Style="{DynamicResource Caption}" Text="{Binding Core.StatusDetail}" Foreground="{DynamicResource Brush.Danger}"/>
                    <TextBlock Style="{DynamicResource Caption}" Margin="{DynamicResource Spacing.SmallTop}">
                        <Run Text="Pipe:"/> <Run Text="{Binding Core.PipeName, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="· Host: Tekla Structures 2025.0"/>
                    </TextBlock>
                    <TextBlock Style="{DynamicResource Caption}" Text="{Binding SelfCheckText}" Foreground="{DynamicResource Brush.Info}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{DynamicResource PrimaryButton}" MinWidth="120" VerticalAlignment="Center"
                        Content="{Binding Core.ToggleButtonText}" Command="{Binding Core.ToggleListenerCommand}"/>
            </Grid>
        </Border>

        <!-- 2. Active Model Card -->
        <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="{DynamicResource Spacing.SmallTop}">
            <StackPanel>
                <TextBlock Style="{DynamicResource BodyStrong}" Text="Active Tekla Model"/>
                <Grid Margin="{DynamicResource Spacing.SmallTop}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{DynamicResource Caption}" Text="Model Name: " Width="85"/>
                    <TextBlock Grid.Column="1" Style="{DynamicResource BodyStrong}" Text="{Binding ModelName}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Safety Controls Card -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="{DynamicResource Spacing.SmallTop}">
            <StackPanel>
                <TextBlock Style="{DynamicResource BodyStrong}" Text="Safety Controls (3-Tier Protection)"/>

                <CheckBox Margin="{DynamicResource Spacing.SmallTop}"
                          IsChecked="{Binding Core.IsExecutionEnabled}"
                          Content="Allow AI code execution (Tier W &amp; D)"
                          ToolTip="Enables scripts received over Named Pipe to execute inside Tekla Structures. Automatically turns off when Tekla restarts."/>

                <CheckBox Margin="{DynamicResource Spacing.SmallTop}"
                          IsEnabled="{Binding CanEnableHeavy}"
                          IsChecked="{Binding IsHeavyEnabled}"
                          Content="Allow Heavy / Destructive operations (Tier D)"
                          ToolTip="Allows destructive operations such as deleting model objects, running IFC export, or batch processing. Gated per-session."/>

                <TextBlock Style="{DynamicResource Caption}" Margin="{DynamicResource Spacing.SmallTop}"
                           Text="* dryRun=true mode cleanly rolls back all in-memory changes via SetTestSavePoint/RollbackToTestSavePoint without persisting to model."/>
            </StackPanel>
        </Border>

        <!-- 4. Execution & Audit History Card -->
        <Border Grid.Row="3" Style="{DynamicResource Card}" Margin="{DynamicResource Spacing.SmallTop}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{DynamicResource BodyStrong}" Text="Last Script Execution"/>
                    <TextBlock Grid.Column="1" Style="{DynamicResource Caption}">
                        <Run Text="Compiled scripts:"/> <Run Text="{Binding Core.CompiledScriptCount, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Row="1" Style="{DynamicResource Caption}" Margin="{DynamicResource Spacing.SmallTop}"
                           Text="{Binding Core.LastRunSummary}" TextWrapping="Wrap"/>

                <TextBox Grid.Row="2" Margin="{DynamicResource Spacing.SmallTop}"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource Font.Family.Mono}" FontSize="{DynamicResource Font.Size.Caption}"
                         Background="{DynamicResource Brush.Surface.Light}" Foreground="{DynamicResource Brush.Foreground.Primary}"
                         BorderBrush="{DynamicResource Brush.Border}"
                         Text="{Binding Core.LastScriptPreview, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- 5. Footer Buttons -->
        <Grid Grid.Row="4" Margin="{DynamicResource Spacing.SmallTop}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{DynamicResource SecondaryButton}" Content="Open Log Folder"
                    Command="{Binding OpenLogFolderCommand}"/>

            <Button Grid.Column="1" Style="{DynamicResource SecondaryButton}" Content="Copy Last Script"
                    Margin="{DynamicResource Spacing.SmallHorizontal}"
                    Command="{Binding Core.CopyLastScriptCommand}"/>

            <Button Grid.Column="3" Style="{DynamicResource SecondaryButton}" Content="Toggle Theme"
                    Command="{Binding ToggleThemeCommand}"/>
        </Grid>
    </Grid>
</Window>
