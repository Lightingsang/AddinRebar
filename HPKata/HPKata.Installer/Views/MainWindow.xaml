<Window x:Class="HPKata.Installer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HPKata.Installer.ViewModels"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="HPKata Suite Setup — Standalone Installer"
        Width="700" Height="500"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}">

    <Window.DataContext>
        <vm:InstallerViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="12" Background="{DynamicResource Brush.Surface}" CornerRadius="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="HPKata Structural Rebar Suite" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="Automated CAD 2026, Revit 2026, and Excel Detailing Engine" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Destination Selection -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12" Background="{DynamicResource Brush.Surface}" CornerRadius="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Target Installation Directory:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseTargetCommand}" Style="{StaticResource Button.Secondary}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <Button Content="Install" Command="{Binding InstallCommand}" Style="{StaticResource Button.Primary}" Width="100" Margin="0,0,8,0"/>
            <Button Content="Repair" Command="{Binding RepairCommand}" Style="{StaticResource Button.Secondary}" Width="90" Margin="0,0,8,0"/>
            <Button Content="Uninstall" Command="{Binding UninstallCommand}" Style="{StaticResource Button.Secondary}" Width="90"/>
        </StackPanel>

        <!-- Live Log Display -->
        <Border Grid.Row="3" Padding="8" Background="{DynamicResource Brush.Surface}" CornerRadius="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Deployment Log:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="4" Margin="0,8,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
