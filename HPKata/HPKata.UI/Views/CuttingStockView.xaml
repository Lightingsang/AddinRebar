<Window x:Class="HPKata.UI.Views.CuttingStockView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:HPKata.UI.ViewModels"
        xmlns:conv="clr-namespace:HPKata.UI.Converters"
        mc:Ignorable="d"
        Title="HPKata — Tổ hợp Cắt thép 1D (11,700 mm Stock Bar Optimizer)"
        Height="670" Width="1020"
        MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPKata.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:NumberFormatConverter x:Key="NumFmt"/>
            <conv:PercentageConverter x:Key="PctFmt"/>
            <conv:EnumDescriptionConverter x:Key="EnumDesc"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:CutsFormattingConverter x:Key="CutsFmt"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="TỐI ƯU HÓA CẮT THÉP 1D (TO_HOP_THEP)" Style="{StaticResource Text.Title}"/>
                <TextBlock Text=" — Standard 11,700 mm Bar &amp; Offcut Warehouse Optimizer" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Body (2 Columns) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Config & Demands -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Configuration Card -->
                <Border Grid.Row="0" Style="{StaticResource Card.Panel}">
                    <StackPanel>
                        <TextBlock Text="Cấu hình bài toán cắt thép" Style="{StaticResource Text.Section}"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Đường kính (Φ mm):" Style="{StaticResource Text.Muted}"/>
                                <ComboBox ItemsSource="{Binding AvailableDiameters}" SelectedItem="{Binding SelectedDiameter, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Thuật toán giải:" Style="{StaticResource Text.Muted}"/>
                                <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDesc}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cây thép (mm):" Style="{StaticResource Text.Muted}"/>
                                <TextBox Text="{Binding StandardStockLengthMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Min kho (mm):" Style="{StaticResource Text.Muted}"/>
                                <TextBox Text="{Binding MinRemnantLengthMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Mạch cưa (mm):" Style="{StaticResource Text.Muted}"/>
                                <TextBox Text="{Binding SawKerfMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Demand List DataGrid -->
                <Border Grid.Row="1" Style="{StaticResource Card.Panel}" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Nhu cầu thanh cần cắt (Demands)" Style="{StaticResource Text.Section}" Margin="0,0,0,4"/>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Demands}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CK" Binding="{Binding ComponentMark}" Width="60"/>
                                <DataGridTextColumn Header="STT" Binding="{Binding BarMark}" Width="50"/>
                                <DataGridTextColumn Header="Φ (mm)" Binding="{Binding DiameterMm}" Width="55"/>
                                <DataGridTextColumn Header="Chiều dài (mm)" Binding="{Binding LengthMm, StringFormat='N0'}" Width="100"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Solve Action -->
                <Button Grid.Row="2"
                        Content="TÍNH TOÁN TỔ HỢP CẮT THÉP"
                        Command="{Binding OptimizeCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="38"
                        HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- Right: Results & Patterns -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>

                <!-- Metrics Summary Card -->
                <Border Grid.Row="0" Style="{StaticResource Card.Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="KẾT QUẢ TỐI ƯU HÓA" Style="{StaticResource Text.Section}"/>

                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cây 11.7m dùng:" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Text="{Binding NewStandardBarsCount}" Style="{StaticResource Text.Bold}" FontSize="15" Foreground="{DynamicResource Brush.Accent}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Đoạn kho dùng:" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Text="{Binding ConsumedWarehouseBarsCount}" Style="{StaticResource Text.Bold}" FontSize="15"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hao hụt thuần:" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Text="{Binding NetWastePercent, Converter={StaticResource PctFmt}}" Style="{StaticResource Text.Bold}" FontSize="15" Foreground="{DynamicResource Brush.Success}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Đầu mẩu vụn (kg):" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Text="{Binding TotalScrapWeightKg, Converter={StaticResource NumFmt}, ConverterParameter='F1'}" Style="{StaticResource Text.Bold}" FontSize="15" Foreground="{DynamicResource Brush.Danger}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Cutting Patterns List -->
                <Border Grid.Row="1" Style="{StaticResource Card.Panel}" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Sơ đồ cắt trên từng thanh (Cutting Patterns)" Style="{StaticResource Text.Section}" Margin="0,0,0,4"/>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding CuttingPatterns}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Phôi thanh" Binding="{Binding StockLengthMm, StringFormat='N0'}" Width="85"/>
                                <DataGridCheckBoxColumn Header="Thép kho" Binding="{Binding IsWarehouseBar}" Width="75"/>
                                <DataGridTextColumn Header="Các đoạn cắt (mm)" Binding="{Binding CutsMm, Converter={StaticResource CutsFmt}}" Width="*"/>
                                <DataGridTextColumn Header="Đoạn thừa (mm)" Binding="{Binding RemnantLengthMm, StringFormat='N0'}" Width="100"/>
                                <DataGridCheckBoxColumn Header="Thu hồi kho" Binding="{Binding IsReusableRemnant}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Recovered Offcuts List -->
                <Border Grid.Row="2" Style="{StaticResource Card.Panel}" Padding="8" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Đoạn thừa đủ chuẩn nhập kho (Warehouse Offcuts Recovered)" Style="{StaticResource Text.Section}" Margin="0,0,0,4"/>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding GeneratedOffcuts}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Φ (mm)" Binding="{Binding DiameterMm}" Width="70"/>
                                <DataGridTextColumn Header="Chiều dài (mm)" Binding="{Binding LengthMm, StringFormat='N0'}" Width="110"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="Quy cách đoạn thừa" Binding="{Binding}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,4" Background="{DynamicResource Brush.Surface}" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}"/>
        </Border>
    </Grid>
</Window>
