<Window x:Class="HPKata.UI.Views.SlabDetailingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HPKata.UI.ViewModels"
        mc:Ignorable="d"
        Title="HPKata — Triển khai Cốt thép Bản sàn &amp; Thép Chân chó"
        Height="620" Width="820"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPKata.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="THIẾT KẾ CỐT THÉP BẢN SÀN (VE_SAN / CHIA_SAN)" Style="{StaticResource Text.Title}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ký hiệu ô: " VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBox Text="{Binding PanelMark}" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Geometry Group -->
                <GroupBox Header="Kích Thước Ô Sàn" Style="{StaticResource GroupBox.Header}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="Nhịp Lx (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding SpanXMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="Nhịp Ly (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding SpanYMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4">
                            <TextBlock Text="Chiều Dày hs (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding ThicknessMm}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Rebar Mesh Group -->
                <GroupBox Header="Cốt Thép Lưới Đáy &amp; Mũ Gối" Style="{StaticResource GroupBox.Header}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="Lớp Đáy X (B1): Phi / a (mm):" Style="{StaticResource Text.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding BottomMeshXDia}" Width="50" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding BottomMeshXSpacing}" Width="70"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="Lớp Đáy Y (B2): Phi / a (mm):" Style="{StaticResource Text.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding BottomMeshYDia}" Width="50" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding BottomMeshYSpacing}" Width="70"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="Thép Mũ Gối: Phi / a (mm):" Style="{StaticResource Text.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding TopSupportDia}" Width="50" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding TopSupportSpacing}" Width="70"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="Tỷ Lệ Đoạn Cắt Mũ Gối (L/4 = 0.25):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding TopSupportRatio}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Chair Bar Group -->
                <GroupBox Header="Tính Toán Chân Chó Kê Sàn (Spacer Stools)" Style="{StaticResource GroupBox.Header}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="Đường Kính Thép Kê:" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding ChairDia}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="Mật Độ (cái/m²):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding ChairDensity}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4">
                            <TextBlock Text="Chiều Cao Chân Kê:" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding CalculatedStoolHeightMm, StringFormat='{}H = {0:F0} mm'}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bê tông: " Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding EstimatedVolumeM3, StringFormat='{}{0:F2} m³'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Text="Thép: " Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding EstimatedWeightKg, StringFormat='{}{0:F1} kg'}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Tính Lại" Command="{Binding RecalculateCommand}" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}"/>
                    <Button Content="Chấp Nhận &amp; Vẽ Sàn" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Primary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
