<Window x:Class="HPKata.UI.Views.WallDetailingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HPKata.UI.ViewModels"
        mc:Ignorable="d"
        Title="HPKata — Triển khai Chi tiết Cốt thép Vách &amp; Lõi thang máy"
        Height="680" Width="960"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPKata.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="THIẾT KẾ &amp; CHI TIẾT CỐT THÉP VÁCH (VE_VACH / VE_LOI_VACH)" Style="{StaticResource Text.Title}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mã vách: " VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBox Text="{Binding WallMark}" Width="80" Margin="4,0,12,0"/>
                    <TextBlock Text="Dày tw (mm): " VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBox Text="{Binding ThicknessMm}" Width="60" Margin="4,0,12,0"/>
                    <TextBlock Text="Dài Lw (mm): " VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBox Text="{Binding LengthMm}" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Excel Integration Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card.Panel}" Padding="8,4" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Excel Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Mở Kata.xlsm" Command="{Binding OpenExcelCommand}"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Mở bảng tính C:\HPKata\Kata.xlsm trên ứng dụng Excel"
                            Height="28" Padding="10,2" Margin="0,0,8,0"/>
                    <Button Content="Đọc từ Excel" Command="{Binding ReadExcelCommand}"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Nhập dữ liệu cốt thép từ Kata.xlsm"
                            Height="28" Padding="10,2" Margin="0,0,8,0"/>
                    <Button Content="Ghi vào Excel" Command="{Binding WriteExcelCommand}"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Lưu các thông số cốt thép hiện tại vào Kata.xlsm"
                            Height="28" Padding="10,2" Margin="0,0,12,0"/>
                    <CheckBox Content="Tự động đồng bộ khi Áp dụng" IsChecked="{Binding AutoSyncOnApply}"
                              Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status Indicator / Feedback -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                             Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ExcelStatus}" Style="{StaticResource Text.Muted}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.0*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Boundary Elements & Openings -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Boundary Element Card -->
                <Border Grid.Row="0" Style="{StaticResource Card.Panel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cấu tạo Vùng biên vách (Cột biên)" Style="{StaticResource Text.Section}"/>
                            <Button Grid.Column="1" Content="Tự tính TCVN" Command="{Binding AutoCalculateBoundaryCommand}" Style="{StaticResource Button.Secondary}"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Bề rộng vùng biên bbz (mm):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BoundaryLengthMm}" Width="100" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Số lượng &amp; đường kính thép đứng:" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <TextBox Text="{Binding BoundaryBarCount}" Width="45" Margin="0,0,4,0"/>
                                <TextBlock Text="d" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BoundaryBarDiameter}" Width="45" Margin="4,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Khoảng cách đai vùng biên (mm):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BoundaryTieSpacing}" Width="100" Margin="0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Openings Card -->
                <Border Grid.Row="2" Style="{StaticResource Card.Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Danh sách Lỗ mở trên vách" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="Thép chéo 45° chống nứt góc và thép tăng cường mép lỗ mở:" Style="{StaticResource Text.Muted}"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Openings}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" Style="{StaticResource StandardDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding OpeningMark}" Width="60"/>
                                <DataGridTextColumn Header="X (mm)" Binding="{Binding XOffsetMm}" Width="75"/>
                                <DataGridTextColumn Header="Y (mm)" Binding="{Binding YOffsetMm}" Width="75"/>
                                <DataGridTextColumn Header="Rộng (mm)" Binding="{Binding WidthMm}" Width="85"/>
                                <DataGridTextColumn Header="Cao (mm)" Binding="{Binding HeightMm}" Width="85"/>
                                <DataGridCheckBoxColumn Header="Thép chéo" Binding="{Binding HasDiagonalBars}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="+ Thêm lỗ mở" Command="{Binding AddOpeningCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
                            <Button Content="- Bớt lỗ mở" Command="{Binding RemoveOpeningCommand}" Style="{StaticResource Button.Secondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Web Mesh Parameters -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card.Panel}">
                        <StackPanel>
                            <TextBlock Text="Lưới thép Thân vách (Web Mesh)" Style="{StaticResource Text.Section}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Bố trí 2 lớp thép (Double):" VerticalAlignment="Center"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding IsDoubleCurtain}" HorizontalAlignment="Right" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Đường kính thép đứng (mm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WebVerticalDiameter}" Width="100" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Khoảng cách thép đứng (mm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WebVerticalSpacing}" Width="100" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Đường kính thép ngang (mm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WebHorizontalDiameter}" Width="100" Margin="0,2"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Khoảng cách thép ngang (mm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding WebHorizontalSpacing}" Width="100" Margin="0,2"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="U-bar bịt đầu mép tự do:" VerticalAlignment="Center"/>
                                <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding HasUBarEdgeCaps}" HorizontalAlignment="Right" Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Click="OnCancelClick" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
                <Button Content="Tạo bản vẽ chi tiết" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Primary}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
