<Window x:Class="HPKata.UI.Views.FoundationDetailingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HPKata.UI.ViewModels"
        mc:Ignorable="d"
        Title="HPKata — Triển khai Chi tiết Móng Đơn &amp; Móng Cọc"
        Height="650" Width="850"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPKata.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="THIẾT KẾ &amp; CHI TIẾT MÓNG (VE_MONG_DON / VE_MONG_COC)" Style="{StaticResource Text.Title}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Đài Cọc (Pile Cap)" IsChecked="{Binding IsPileCap}" Margin="0,0,16,0" Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock Text="Ký hiệu: " VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBox Text="{Binding FoundationMark}" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Geometry Group -->
                <GroupBox Header="Kích Thước Hình Học Đài / Móng" Style="{StaticResource GroupBox.Header}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="Chiều Dài L (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding LengthMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="Chiều Rộng B (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding WidthMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                            <TextBlock Text="Chiều Cao H (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding TotalHeightMm}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="Bản Đáy h1 (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding BaseSlabHeightMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="Cổ Móng lc (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding PedestalLengthMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="4">
                            <TextBlock Text="Cổ Móng bc (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding PedestalWidthMm}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Pile Cap Specific Group -->
                <GroupBox Header="Thông Số Cọc &amp; Giật Cấp (Áp dụng khi chọn Đài Cọc)" Style="{StaticResource GroupBox.Header}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="Số Lượng Cọc (1-9+):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding PileCount}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="Đường Kính Cọc D (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding PileDiameterMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                            <CheckBox Content="Đài Giật Cấp (2 Cấp)" IsChecked="{Binding IsStepped}" Margin="0,16,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="Cấp 2 L2 (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Tier2LengthMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="Cấp 2 B2 (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Tier2WidthMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="4">
                            <TextBlock Text="Cấp 2 H2 (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Tier2HeightMm}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Rebar Group -->
                <GroupBox Header="Cốt Thép Lưới Đáy &amp; Thép Chờ" Style="{StaticResource GroupBox.Header}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="Đáy X: Phi / a (mm):" Style="{StaticResource Text.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding BottomMeshXDia}" Width="50" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding BottomMeshXSpacing}" Width="70"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="Đáy Y: Phi / a (mm):" Style="{StaticResource Text.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding BottomMeshYDia}" Width="50" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding BottomMeshYSpacing}" Width="70"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                            <CheckBox Content="Bố trí thép lớp trên" IsChecked="{Binding HasTopMesh}" Margin="0,16,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="Số Thép Chờ Cột:" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding StarterDowelCount}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="Đường Kính Thép Chờ:" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding StarterDowelDia}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="4">
                            <TextBlock Text="Chiều Dài Nối Chờ (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding StarterDowelLap}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bê tông: " Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding EstimatedVolumeM3, StringFormat='{}{0:F2} m³'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Text="Khối lượng thép: " Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding EstimatedWeightKg, StringFormat='{}{0:F1} kg'}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Tính Toán Lại" Command="{Binding RecalculateCommand}" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}"/>
                    <Button Content="Chấp Nhận &amp; Xuất Bản Vẽ" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Primary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
