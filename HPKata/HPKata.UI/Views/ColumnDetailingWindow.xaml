<Window x:Class="HPKata.UI.Views.ColumnDetailingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HPKata.UI.ViewModels"
        mc:Ignorable="d"
        Title="HPKata — Triển khai Chi tiết Cốt thép Cột nhiều tầng"
        Height="680" Width="960"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPKata.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="THIẾT KẾ &amp; CHI TIẾT CỐT THÉP CỘT (VE_COT / VE_COT_SHOP)" Style="{StaticResource Text.Title}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Chế độ Shop 11.7m" IsChecked="{Binding IsShopMode}" Margin="0,0,16,0" Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock Text="Cột: " VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBox Text="{Binding ColumnMark}" Width="80" Margin="4,0,12,0"/>
                    <TextBlock Text="Bê tông: " VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBox Text="{Binding ConcreteGrade}" Width="60" Margin="4,0,12,0"/>
                    <TextBlock Text="Thép chủ: " VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBox Text="{Binding MainSteelGrade}" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Excel Integration Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card.Panel}" Padding="8,4" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Excel Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Mở Kata.xlsm" Command="{Binding OpenExcelCommand}"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Mở bảng tính C:\HPKata\Kata.xlsm trên ứng dụng Excel"
                            Height="28" Padding="10,2" Margin="0,0,8,0"/>
                    <Button Content="Đọc từ Excel" Command="{Binding ReadExcelCommand}"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Nhập dữ liệu cốt thép từ Kata.xlsm"
                            Height="28" Padding="10,2" Margin="0,0,8,0"/>
                    <Button Content="Ghi vào Excel" Command="{Binding WriteExcelCommand}"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Lưu các thông số cốt thép hiện tại vào Kata.xlsm"
                            Height="28" Padding="10,2" Margin="0,0,12,0"/>
                    <CheckBox Content="Tự động đồng bộ khi Áp dụng" IsChecked="{Binding AutoSyncOnApply}"
                              Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status Indicator / Feedback -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                             Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ExcelStatus}" Style="{StaticResource Text.Muted}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.0*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Stories Table & Dimensions -->
            <Border Grid.Column="0" Style="{StaticResource Card.Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Danh sách Tầng cột" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="Khai báo chiều cao tầng H, dầm hd, tiết diện b x h và cốt thép từng tầng:" Style="{StaticResource Text.Muted}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Stories}" AutoGenerateColumns="False"
                              CanUserAddRows="False" Style="{StaticResource StandardDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tầng" Binding="{Binding StoryName}" Width="80"/>
                            <DataGridTextColumn Header="H (mm)" Binding="{Binding StoryHeightMm}" Width="75"/>
                            <DataGridTextColumn Header="hd (mm)" Binding="{Binding BeamDepthMm}" Width="75"/>
                            <DataGridTextColumn Header="b (mm)" Binding="{Binding WidthMm}" Width="70"/>
                            <DataGridTextColumn Header="h (mm)" Binding="{Binding DepthMm}" Width="70"/>
                            <DataGridTextColumn Header="Thép góc" Binding="{Binding CornerDiameter, StringFormat='4d{0}'}" Width="80"/>
                            <DataGridTextColumn Header="Đai a1" Binding="{Binding DenseSpacing}" Width="70"/>
                            <DataGridTextColumn Header="Đai a2" Binding="{Binding SparseSpacing}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Thêm tầng" Command="{Binding AddStoryCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
                        <Button Content="- Bớt tầng" Command="{Binding RemoveStoryCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
                        <Button Content="Tối ưu hóa cốt thép" Command="{Binding AutoSizeBarsCommand}" Style="{StaticResource Button.Secondary}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Detailing Parameters -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Splice & Transition Card -->
                    <Border Style="{StaticResource Card.Panel}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Cấu tạo Nối thép &amp; Cổ chai" Style="{StaticResource Text.Section}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Phương pháp nối:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SpliceMethod}" Width="100" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Hệ số nối chồng (x d):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LapLengthFactor}" Width="100" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Khoảng sole nối (mm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StaggerOffsetMm}" Width="100" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Độ lệch uốn cổ chai max (mm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxCrankStepDownMm}" Width="100" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tie Configuration Card -->
                    <Border Style="{StaticResource Card.Panel}">
                        <StackPanel>
                            <TextBlock Text="Cấu tạo Cốt đai &amp; Vùng giữ nở l0" Style="{StaticResource Text.Section}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Đường kính đai (mm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TieDiameter}" Width="100" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Khoảng cách đai dày a1 (mm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DenseSpacing}" Width="100" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Khoảng cách đai thưa a2 (mm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SparseSpacing}" Width="100" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Kiểu đai trong:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding InnerHoopType}" Width="100" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Click="OnCancelClick" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
                <Button Content="Tạo bản vẽ chi tiết" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Primary}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
