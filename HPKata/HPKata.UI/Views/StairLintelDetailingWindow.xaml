<Window x:Class="HPKata.UI.Views.StairLintelDetailingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HPKata.UI.ViewModels"
        mc:Ignorable="d"
        Title="HPKata — Triển khai Cốt thép Cầu thang &amp; Lanh tô"
        Height="620" Width="820"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPKata.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CHI TIẾT CỐT THÉP THANG &amp; LANH TÔ (VE_THANG / VELANHTO)" Style="{StaticResource Text.Title}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Vế Thang" IsChecked="{Binding IsStair}" Margin="0,0,12,0"/>
                    <RadioButton Content="Lanh Tô" Margin="0,0,16,0"/>
                    <TextBlock Text="Ký hiệu: " VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBox Text="{Binding StairMark}" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Stair Geometry Group -->
                <GroupBox Header="Thông Số Hình Học Vế Thang (ve_thang)" Style="{StaticResource GroupBox.Header}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="Số Bậc (Risers):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding RiserCount}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="Chiều Cao Bậc hr (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding RiserHeightMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                            <TextBlock Text="Bề Rộng Bậc bt (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding TreadWidthMm}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="Bề Rộng Vế W (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding FlightWidthMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="Chiều Dày Bản tw (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding ThroatThicknessMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="4">
                            <TextBlock Text="Kiểm Tra Nhân Trắc Học (2h+b):" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding BlondelValue, StringFormat='{}2h + b = {0:F0} mm (Chuẩn 600-640)'}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Stair Rebar Group -->
                <GroupBox Header="Cốt Thép Bản Thang &amp; Uốn Chéo Scissor-Crank (Góc Lõm)" Style="{StaticResource GroupBox.Header}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="Thép Nhịp: Phi / a (mm):" Style="{StaticResource Text.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding BottomTensionDia}" Width="50" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding BottomTensionSpacing}" Width="70"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="Thép Mũ Gối: Phi / a (mm):" Style="{StaticResource Text.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding TopNegativeDia}" Width="50" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding TopNegativeSpacing}" Width="70"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4">
                            <TextBlock Text="Đoạn Nối Scissor (L_ext >= 35d):" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding ScissorExtensionMm, StringFormat='{}L_ext = {0:F0} mm'}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Lintel Group -->
                <GroupBox Header="Thông Số Lanh Tô (velanhto)" Style="{StaticResource GroupBox.Header}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="Nhịp Thông Thủy L0 (mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding ClearSpanMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="Đoạn Gác Tường (>=200mm):" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding BearingLengthMm}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                            <TextBlock Text="Bề Rộng x Chiều Cao (mm):" Style="{StaticResource Text.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding LintelWidthMm}" Width="55" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding LintelHeightMm}" Width="55"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="Thép Giá Trên: n x Phi:" Style="{StaticResource Text.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding TopHangerCount}" Width="50" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding TopHangerDia}" Width="50"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="Thép Chủ Dưới: n x Phi:" Style="{StaticResource Text.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding BottomTensionCount}" Width="50" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding LintelBottomDia}" Width="50"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="4">
                            <TextBlock Text="Thép Đai Lanh Tô:" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding LintelStirrupDia}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bê tông: " Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding EstimatedVolumeM3, StringFormat='{}{0:F2} m³'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Text="Thép: " Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding EstimatedWeightKg, StringFormat='{}{0:F1} kg'}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Tính Lại" Command="{Binding RecalculateCommand}" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}"/>
                    <Button Content="Chấp Nhận &amp; Xuất Bản Vẽ" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Primary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
