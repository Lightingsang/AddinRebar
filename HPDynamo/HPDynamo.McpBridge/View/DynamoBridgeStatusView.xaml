<Window x:Class="HPDynamo.McpBridge.View.DynamoBridgeStatusView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HPRebar.McpBridge.Core.ViewModel;assembly=HPRebar.McpBridge.Core"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:McpBridgeStatusViewModel}"
        Title="HPDynamo MCP Bridge"
        Width="580" Height="640"
        MinWidth="500" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource Font.Family.Default}"
        FontSize="{DynamicResource Font.Size.Body}"
        Foreground="{DynamicResource Brush.Foreground.Primary}"
        TextElement.FontFamily="{DynamicResource Font.Family.Default}"
        TextElement.Foreground="{DynamicResource Brush.Foreground.Primary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HPDynamo.McpBridge;component/Resources/Themes/MaterialBridge.xaml"/>
                <ResourceDictionary Source="/HPDynamo.McpBridge;component/Resources/Themes/ThemeDark.xaml"/>
                <ResourceDictionary Source="/HPDynamo.McpBridge;component/Resources/Themes/DynamoTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="StatusDot" TargetType="Ellipse">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Fill" Value="{DynamicResource Brush.Foreground.Tertiary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusKind}" Value="Listening">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Info}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="Connected">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="Busy">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CompileCountText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompileCountHigh}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource Spacing.Medium}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Connection State & Listener Control -->
        <Border Grid.Row="0" Style="{DynamicResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Style="{DynamicResource StatusDot}" Margin="{DynamicResource Spacing.SmallHorizontal}"/>

                <StackPanel Grid.Column="1" Margin="{DynamicResource Spacing.SmallHorizontal}" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource Subheading}" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                    <TextBlock Style="{DynamicResource Caption}" Text="{Binding StatusDetail}" Foreground="{DynamicResource Brush.Danger}"
                               AutomationProperties.AutomationId="StatusDetail"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <md:PackIcon Kind="Pipe" Width="14" Height="14" Foreground="{DynamicResource Brush.Foreground.Secondary}"
                                     Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{DynamicResource Caption}" VerticalAlignment="Center">
                            <Run Text="{Binding PipeName, Mode=OneWay}"/>
                            <Run Text=" · Revit"/> <Run Text="{Binding RevitVersion, Mode=OneWay}"/> <Run Text="/ Dynamo 3.7"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Style="{DynamicResource PrimaryButton}" MinWidth="130" Height="36" VerticalAlignment="Center"
                        Command="{Binding ToggleListenerCommand}" AutomationProperties.AutomationId="ToggleListener">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="Power" Width="16" Height="16" Foreground="{DynamicResource Brush.Accent.Foreground}"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ToggleButtonText}" Foreground="{DynamicResource Brush.Accent.Foreground}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Safety Card: Mandatory AI Execution Opt-In -->
        <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="{DynamicResource Spacing.MediumTop}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <md:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Style="{DynamicResource BodyStrong}" Text="Safety &amp; Execution Authorization" VerticalAlignment="Center"/>
                </StackPanel>

                <CheckBox Margin="{DynamicResource Spacing.SmallTop}"
                          AutomationProperties.AutomationId="AllowExecution"
                          AutomationProperties.Name="Allow AI Dynamo execution"
                          IsChecked="{Binding IsExecutionEnabled}">
                    <TextBlock Text="Allow AI Dynamo execution" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Foreground.Primary}"/>
                </CheckBox>

                <Border Background="{DynamicResource Brush.Background}" CornerRadius="4" Padding="10,6" Margin="0,6,0,6">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{DynamicResource Brush.Info}"
                                     Margin="0,2,8,0" VerticalAlignment="Top"/>
                        <TextBlock Style="{DynamicResource Caption}" TextWrapping="Wrap"
                                   Text="Off by default each session. When enabled, authorizes AI agents to run DesignScript, C# Dynamo code, and .dyn graphs. Document-modifying operations are wrapped in Revit TransactionGroups and rolled back during dry runs."/>
                    </StackPanel>
                </Border>

                <CheckBox Margin="{DynamicResource Spacing.SmallTop}"
                          AutomationProperties.AutomationId="AutoStartListener"
                          AutomationProperties.Name="Start pipe listener automatically on Revit startup"
                          IsChecked="{Binding AutoStartListener}">
                    <TextBlock Text="Start pipe listener automatically on Revit startup" Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Last Run Card: Execution Inspector -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="{DynamicResource Spacing.MediumTop}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource LinkButton}"
                            Command="{Binding CopyLastScriptCommand}" AutomationProperties.AutomationId="CopyLastScript">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <md:PackIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{DynamicResource Brush.Accent}"
                                         Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Copy script" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="CodeBraces" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{DynamicResource BodyStrong}" Text="Last executed graph / script" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock Grid.Row="1" Style="{DynamicResource Caption}" Margin="{DynamicResource Spacing.SmallTop}"
                           Text="{Binding LastRunSummary}"/>

                <TextBox Grid.Row="2" Style="{DynamicResource StandardTextBox}" Margin="{DynamicResource Spacing.SmallTop}"
                         Text="{Binding LastScriptPreview, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="{DynamicResource Font.Family.Mono}" FontSize="{DynamicResource Font.Size.Caption}"
                         md:HintAssist.Hint="No script has been executed yet"
                         md:HintAssist.IsFloating="False"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- Footer: Diagnostics, Audit & Window Controls -->
        <Grid Grid.Row="3" Margin="{DynamicResource Spacing.MediumTop}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <md:PackIcon Kind="Memory" Width="14" Height="14" Foreground="{DynamicResource Brush.Foreground.Secondary}"
                                 Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Style="{DynamicResource CompileCountText}" VerticalAlignment="Center">
                        <Run Text="Roslyn cache:"/> <Run Text="{Binding CompiledScriptCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" scripts"/>
                    </TextBlock>
                </StackPanel>
                <Button Style="{DynamicResource LinkButton}" HorizontalAlignment="Left"
                        Command="{Binding OpenAuditFolderCommand}" ToolTip="{Binding AuditDirectory}"
                        AutomationProperties.AutomationId="OpenAuditFolder">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="FolderOpenOutline" Width="14" Height="14" Foreground="{DynamicResource Brush.Accent}"
                                     Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Open audit folder" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource SecondaryButton}" MinWidth="130" Height="36"
                        Margin="{DynamicResource Spacing.SmallHorizontal}"
                        Command="{Binding RestartBridgeCommand}" AutomationProperties.AutomationId="RestartBridge"
                        ToolTip="Closes and reopens named pipe listener without clearing compiled script cache.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="Restart" Width="16" Height="16" Foreground="{DynamicResource Brush.Foreground.Primary}"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Restart bridge" Foreground="{DynamicResource Brush.Foreground.Primary}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource PrimaryButton}" MinWidth="100" Height="36"
                        Command="{Binding CloseCommand}" AutomationProperties.AutomationId="CloseBridge">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource Brush.Accent.Foreground}"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Close" Foreground="{DynamicResource Brush.Accent.Foreground}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
