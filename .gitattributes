# Revit models are large binaries — keep them out of the git object store.
*.rvt filter=lfs diff=lfs merge=lfs -text
*.rfa filter=lfs diff=lfs merge=lfs -text
*.rte filter=lfs diff=lfs merge=lfs -text

# The skill-sync tests compare fixture bytes literally, so these files must stay LF
# whatever core.autocrlf is set to on the machine checking them out.
tests/skill-sync/fixtures/** text eol=lf
