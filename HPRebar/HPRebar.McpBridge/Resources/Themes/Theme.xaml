<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- MaterialDesign first (see HPRebar's Theme.xaml); the palette and the token dictionaries below keep the last word. -->
        <ResourceDictionary Source="pack://application:,,,/HPRebar.McpBridge;component/Resources/Themes/MaterialBridge.xaml"/>

        <!-- Color tokens. Default = Dark (match Revit 2024+); swapped at runtime by MaterialThemeBridge. -->
        <ResourceDictionary Source="pack://application:,,,/HPRebar.McpBridge;component/Resources/Themes/ThemeDark.xaml"/>

        <ResourceDictionary Source="pack://application:,,,/HPRebar.McpBridge;component/Resources/Themes/Typography.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HPRebar.McpBridge;component/Resources/Themes/Spacing.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HPRebar.McpBridge;component/Resources/Themes/Controls.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HPRebar.McpBridge;component/Resources/Themes/ThemeIcons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Implicit Styles for Standard Controls ===== -->
    <Style TargetType="TextBox" BasedOn="{StaticResource StandardTextBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource StandardComboBox}"/>
    <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}"/>
    <Style TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignRadioButton}"/>
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>
    <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}"/>
    <Style TargetType="TabControl" BasedOn="{StaticResource MaterialDesignTabControl}"/>
    <Style TargetType="Expander" BasedOn="{StaticResource MaterialDesignExpander}"/>

</ResourceDictionary>
