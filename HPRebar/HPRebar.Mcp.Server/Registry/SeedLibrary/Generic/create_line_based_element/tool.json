{
  "name": "create_line_based_element",
  "version": 1,
  "status": "published",
  "author": "hprebar",
  "category": "Generic",
  "transaction": "auto",
  "timeoutSeconds": 90,
  "destructive": true,
  "revitVersions": [
    "2025",
    "2026"
  ],
  "tags": [
    "wall",
    "beam",
    "duct",
    "pipe",
    "create"
  ],
  "title": "Create line-based elements",
  "description": "Create walls, beams (structural framing), ducts, pipes, conduits, cable trays or any line-based family instance from start/end points in mm. baseLevel is an elevation in mm — the nearest level is used and the remainder becomes the base offset. Walls: thickness picks/creates a wall type of that width, height is the unconnected height. Beams/MEP curves use the points' Z as absolute elevation. Give typeId (from get_available_family_types) to pick a specific type; otherwise the first type of the category is used and reported.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "OST_Walls, OST_StructuralFraming, OST_DuctCurves, OST_PipeCurves, OST_Conduit, OST_CableTray, or a category with line-based families"
            },
            "typeId": {
              "type": "integer",
              "description": "ElementId of the type to use (optional)"
            },
            "locationLine": {
              "type": "object",
              "properties": {
                "p0": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "z"
                  ]
                },
                "p1": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "z"
                  ]
                }
              },
              "required": [
                "p0",
                "p1"
              ]
            },
            "thickness": {
              "type": "number",
              "description": "Wall width / duct width / pipe diameter in mm (optional)"
            },
            "height": {
              "type": "number",
              "description": "Wall height in mm (default 3000) / duct height"
            },
            "baseLevel": {
              "type": "number",
              "description": "Base elevation in mm (nearest level is used)"
            },
            "baseOffset": {
              "type": "number",
              "default": 0,
              "description": "Offset from the base level in mm"
            },
            "structural": {
              "type": "boolean",
              "default": false,
              "description": "Walls: structural usage"
            }
          },
          "required": [
            "category",
            "locationLine",
            "baseLevel"
          ]
        }
      }
    },
    "required": [
      "data"
    ],
    "additionalProperties": false
  }
}
