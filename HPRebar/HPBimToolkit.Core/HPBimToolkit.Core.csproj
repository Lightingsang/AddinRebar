<Project Sdk="Microsoft.NET.Sdk">

    <!-- Host-free half of the HP BIM Toolkit: the dashboard's wire contracts, rules and pure aggregation; the protocol
         itself comes from HPWebHost.Core (ADR-0010). Never references Autodesk.*, so it is testable without Revit. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>HPBimToolkit.Core</RootNamespace>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\HPWebHost.Core\HPWebHost.Core.csproj"/>
    </ItemGroup>

</Project>
