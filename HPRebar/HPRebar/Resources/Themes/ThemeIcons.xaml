<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- Tab Icons - Vector ControlTemplates (Viewbox 32x32)                -->
    <!-- Ported from DrawIcon.cs and styled for Revit Dark/Light themes   -->
    <!-- ================================================================= -->

    <!-- 1. TabIcon.Setting -->
    <ControlTemplate x:Key="TabIcon.Setting" TargetType="Control">
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Canvas Width="32" Height="32">
                <Ellipse Width="24" Height="24" Canvas.Left="4" Canvas.Top="4"
                         Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <Ellipse Width="16" Height="16" Canvas.Left="8" Canvas.Top="8"
                         Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <!-- Top tooth -->
                <Line X1="13" Y1="0" X2="13" Y2="4" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <Line X1="19" Y1="0" X2="19" Y2="4" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <Line X1="13" Y1="0" X2="19" Y2="0" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <!-- Bottom tooth -->
                <Line X1="13" Y1="28" X2="13" Y2="32" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <Line X1="19" Y1="28" X2="19" Y2="32" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <Line X1="13" Y1="32" X2="19" Y2="32" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <!-- Left tooth -->
                <Line X1="0" Y1="13" X2="4" Y2="13" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <Line X1="0" Y1="19" X2="4" Y2="19" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <Line X1="0" Y1="13" X2="0" Y2="19" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <!-- Right tooth -->
                <Line X1="28" Y1="13" X2="32" Y2="13" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <Line X1="28" Y1="19" X2="32" Y2="19" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
                <Line X1="32" Y1="13" X2="32" Y2="19" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.2"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- 2. TabIcon.Geometry -->
    <ControlTemplate x:Key="TabIcon.Geometry" TargetType="Control">
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Canvas Width="32" Height="32">
                <!-- Top beam outline -->
                <Rectangle Width="24" Height="5" Canvas.Left="4" Canvas.Top="2"
                           Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <!-- Bottom beam outline -->
                <Rectangle Width="24" Height="5" Canvas.Left="4" Canvas.Top="25"
                           Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <!-- Column core highlight -->
                <Rectangle Width="6" Height="18" Canvas.Left="13" Canvas.Top="7"
                           Fill="{DynamicResource Brush.Danger}"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- 3. TabIcon.Stirrups (Highlighted outer and inner stirrup ties) -->
    <ControlTemplate x:Key="TabIcon.Stirrups" TargetType="Control">
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Canvas Width="32" Height="32">
                <!-- Column concrete perimeter -->
                <Rectangle Width="28" Height="28" Canvas.Left="2" Canvas.Top="2"
                           Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="0.8"/>
                <!-- Outer stirrup (highlighted) -->
                <Rectangle Width="24" Height="24" Canvas.Left="4" Canvas.Top="4" RadiusX="2" RadiusY="2"
                           Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
                <!-- Inner ties (highlighted) -->
                <Line X1="12" Y1="4" X2="12" Y2="28" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1.8"/>
                <Line X1="20" Y1="4" X2="20" Y2="28" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1.8"/>
                <!-- Rebar dots (secondary/inactive) -->
                <Ellipse Width="4" Height="4" Canvas.Left="6" Canvas.Top="6" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
                <Ellipse Width="4" Height="4" Canvas.Left="14" Canvas.Top="6" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
                <Ellipse Width="4" Height="4" Canvas.Left="22" Canvas.Top="6" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
                <Ellipse Width="4" Height="4" Canvas.Left="6" Canvas.Top="22" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
                <Ellipse Width="4" Height="4" Canvas.Left="14" Canvas.Top="22" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
                <Ellipse Width="4" Height="4" Canvas.Left="22" Canvas.Top="22" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- 4. TabIcon.AdditionalStirrups (Highlighted cross-ties) -->
    <ControlTemplate x:Key="TabIcon.AdditionalStirrups" TargetType="Control">
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Canvas Width="32" Height="32">
                <!-- Column concrete perimeter -->
                <Rectangle Width="28" Height="28" Canvas.Left="2" Canvas.Top="2"
                           Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="0.8"/>
                <!-- Outer stirrup (secondary/neutral) -->
                <Rectangle Width="24" Height="24" Canvas.Left="4" Canvas.Top="4" RadiusX="2" RadiusY="2"
                           Stroke="{DynamicResource Brush.Foreground.Secondary}" StrokeThickness="1.5"/>
                <!-- Cross-ties (highlighted in accent/danger) -->
                <Line X1="12" Y1="4" X2="12" Y2="28" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
                <Line X1="20" Y1="4" X2="20" Y2="28" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
                <!-- Rebar dots -->
                <Ellipse Width="4" Height="4" Canvas.Left="6" Canvas.Top="6" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
                <Ellipse Width="4" Height="4" Canvas.Left="14" Canvas.Top="6" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
                <Ellipse Width="4" Height="4" Canvas.Left="22" Canvas.Top="6" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
                <Ellipse Width="4" Height="4" Canvas.Left="6" Canvas.Top="22" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
                <Ellipse Width="4" Height="4" Canvas.Left="14" Canvas.Top="22" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
                <Ellipse Width="4" Height="4" Canvas.Left="22" Canvas.Top="22" Fill="{DynamicResource Brush.Foreground.Secondary}"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- 5. TabIcon.Bars (Highlighted longitudinal main bars) -->
    <ControlTemplate x:Key="TabIcon.Bars" TargetType="Control">
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Canvas Width="32" Height="32">
                <!-- Column concrete perimeter -->
                <Rectangle Width="28" Height="28" Canvas.Left="2" Canvas.Top="2"
                           Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="0.8"/>
                <!-- Outer stirrup (secondary/neutral) -->
                <Rectangle Width="24" Height="24" Canvas.Left="4" Canvas.Top="4" RadiusX="2" RadiusY="2"
                           Stroke="{DynamicResource Brush.Foreground.Secondary}" StrokeThickness="1.5"/>
                <!-- Inner ties (secondary/neutral) -->
                <Line X1="12" Y1="4" X2="12" Y2="28" Stroke="{DynamicResource Brush.Foreground.Secondary}" StrokeThickness="1.2"/>
                <Line X1="20" Y1="4" X2="20" Y2="28" Stroke="{DynamicResource Brush.Foreground.Secondary}" StrokeThickness="1.2"/>
                <!-- Rebar dots (highlighted in danger/accent) -->
                <Ellipse Width="4.5" Height="4.5" Canvas.Left="5.75" Canvas.Top="5.75" Fill="{DynamicResource Brush.Danger}"/>
                <Ellipse Width="4.5" Height="4.5" Canvas.Left="13.75" Canvas.Top="5.75" Fill="{DynamicResource Brush.Danger}"/>
                <Ellipse Width="4.5" Height="4.5" Canvas.Left="21.75" Canvas.Top="5.75" Fill="{DynamicResource Brush.Danger}"/>
                <Ellipse Width="4.5" Height="4.5" Canvas.Left="5.75" Canvas.Top="21.75" Fill="{DynamicResource Brush.Danger}"/>
                <Ellipse Width="4.5" Height="4.5" Canvas.Left="13.75" Canvas.Top="21.75" Fill="{DynamicResource Brush.Danger}"/>
                <Ellipse Width="4.5" Height="4.5" Canvas.Left="21.75" Canvas.Top="21.75" Fill="{DynamicResource Brush.Danger}"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- 6. TabIcon.TopDowels -->
    <ControlTemplate x:Key="TabIcon.TopDowels" TargetType="Control">
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Canvas Width="32" Height="32">
                <!-- Column side borders -->
                <Line X1="7" Y1="8" X2="7" Y2="30" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <Line X1="25" Y1="8" X2="25" Y2="30" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <!-- Beam bottom line -->
                <Line X1="7" Y1="8" X2="25" Y2="8" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <!-- Floor level dashed line -->
                <Line X1="2" Y1="30" X2="30" Y2="30" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"
                      StrokeDashArray="3 2"/>
                <!-- Main top dowels / rebar runs extending up (highlighted) -->
                <Line X1="10" Y1="1" X2="10" Y2="30" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
                <Line X1="22" Y1="1" X2="22" Y2="30" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
                <!-- Stirrups -->
                <Line X1="10" Y1="12" X2="22" Y2="12" Stroke="{DynamicResource Brush.Foreground.Secondary}" StrokeThickness="1.5"/>
                <Line X1="10" Y1="18" X2="22" Y2="18" Stroke="{DynamicResource Brush.Foreground.Secondary}" StrokeThickness="1.5"/>
                <Line X1="10" Y1="24" X2="22" Y2="24" Stroke="{DynamicResource Brush.Foreground.Secondary}" StrokeThickness="1.5"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- 7. TabIcon.BottomDowels -->
    <ControlTemplate x:Key="TabIcon.BottomDowels" TargetType="Control">
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Canvas Width="32" Height="32">
                <!-- Column side borders -->
                <Line X1="7" Y1="2" X2="7" Y2="20" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <Line X1="25" Y1="2" X2="25" Y2="20" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <!-- Footing step boundary -->
                <Line X1="2" Y1="20" X2="7" Y2="20" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <Line X1="25" Y1="20" X2="30" Y2="20" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <Line X1="2" Y1="20" X2="2" Y2="30" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <Line X1="30" Y1="20" X2="30" Y2="30" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <Line X1="2" Y1="30" X2="30" Y2="30" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <!-- Starter dowels with L-bend (highlighted in danger/accent) -->
                <Polyline Points="10,2 10,27 3,27" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
                <Polyline Points="22,2 22,27 29,27" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
                <!-- Horizontal ties -->
                <Line X1="10" Y1="8" X2="22" Y2="8" Stroke="{DynamicResource Brush.Foreground.Secondary}" StrokeThickness="1.5"/>
                <Line X1="10" Y1="14" X2="22" Y2="14" Stroke="{DynamicResource Brush.Foreground.Secondary}" StrokeThickness="1.5"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- 8. TabIcon.BarsDivision -->
    <ControlTemplate x:Key="TabIcon.BarsDivision" TargetType="Control">
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Canvas Width="32" Height="32">
                <!-- Column elevation segment outline -->
                <Rectangle Width="28" Height="20" Canvas.Left="2" Canvas.Top="6"
                           Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1"/>
                <!-- Top lap-spliced rebar line (highlighted) -->
                <Line X1="4" Y1="11" X2="18" Y2="11" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
                <Line X1="14" Y1="14" X2="28" Y2="14" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
                <!-- Bottom lap-spliced rebar line (highlighted) -->
                <Line X1="4" Y1="19" X2="18" Y2="19" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
                <Line X1="14" Y1="22" X2="28" Y2="22" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

</ResourceDictionary>
