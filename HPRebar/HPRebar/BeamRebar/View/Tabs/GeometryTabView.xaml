<UserControl x:Class="HPRebar.BeamRebar.View.Tabs.GeometryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource Spacing.Small}">
            <TextBlock Text="{Binding Localization.Strings.BeamStackSummary}"
                       Style="{DynamicResource Heading}"
                       Margin="{DynamicResource Spacing.SmallBottom}"/>

            <!-- Summary Card -->
            <Border Style="{DynamicResource Card}" Margin="{DynamicResource Spacing.SmallBottom}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Localization.Strings.Spans}"
                                   Style="{DynamicResource Caption}"
                                   Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                        <TextBlock Text="{Binding SpanCount}"
                                   Style="{DynamicResource BodyStrong}"
                                   FontSize="{DynamicResource Font.Size.Subheading}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Localization.Strings.Supports}"
                                   Style="{DynamicResource Caption}"
                                   Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                        <TextBlock Text="{Binding SupportCount}"
                                   Style="{DynamicResource BodyStrong}"
                                   FontSize="{DynamicResource Font.Size.Subheading}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Localization.Strings.Length}"
                                   Style="{DynamicResource Caption}"
                                   Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                        <TextBlock Text="{Binding TotalLength, StringFormat='{}L={0:0.#} mm'}"
                                   Style="{DynamicResource BodyStrong}"
                                   FontSize="{DynamicResource Font.Size.Subheading}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="{Binding Localization.Strings.Height}"
                                   Style="{DynamicResource Caption}"
                                   Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                        <TextBlock Text="{Binding MaxHeight, StringFormat='{}h_max={0:0.#} mm'}"
                                   Style="{DynamicResource BodyStrong}"
                                   FontSize="{DynamicResource Font.Size.Subheading}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Continuous Spans DataGrid -->
            <TextBlock Text="{Binding Localization.Strings.Spans}"
                       Style="{DynamicResource BodyStrong}"
                       Margin="{DynamicResource Spacing.MediumTop}"/>

            <DataGrid Margin="{DynamicResource Spacing.SmallTop}"
                      ItemsSource="{Binding Spans}"
                      SelectedIndex="{Binding Session.SelectedSpanIndex}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="{DynamicResource Brush.Surface}"
                      RowBackground="{DynamicResource Brush.Surface}"
                      AlternatingRowBackground="{DynamicResource Brush.SurfaceElevated}"
                      Foreground="{DynamicResource Brush.Foreground.Primary}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                      MaxHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Span" Binding="{Binding Name}" Width="100"/>
                    <DataGridTextColumn Header="Clear Ln (mm)" Binding="{Binding LengthClear, StringFormat={}{0:0.#}}" Width="120"/>
                    <DataGridTextColumn Header="C-to-C (mm)" Binding="{Binding LengthCenter, StringFormat={}{0:0.#}}" Width="110"/>
                    <DataGridTextColumn Header="Width b (mm)" Binding="{Binding Width, StringFormat={}{0:0.#}}" Width="110"/>
                    <DataGridTextColumn Header="Height h (mm)" Binding="{Binding Height, StringFormat={}{0:0.#}}" Width="110"/>
                    <DataGridTextColumn Header="Cantilever" Binding="{Binding Cantilever}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bearing Supports DataGrid -->
            <TextBlock Text="{Binding Localization.Strings.Supports}"
                       Style="{DynamicResource BodyStrong}"
                       Margin="{DynamicResource Spacing.MediumTop}"/>

            <DataGrid Margin="{DynamicResource Spacing.SmallTop}"
                      ItemsSource="{Binding Supports}"
                      SelectedIndex="{Binding Session.SelectedSupportIndex}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="{DynamicResource Brush.Surface}"
                      RowBackground="{DynamicResource Brush.Surface}"
                      AlternatingRowBackground="{DynamicResource Brush.SurfaceElevated}"
                      Foreground="{DynamicResource Brush.Foreground.Primary}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                      MaxHeight="150">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Support" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="Width (mm)" Binding="{Binding Width, StringFormat={}{0:0.#}}" Width="120"/>
                    <DataGridTextColumn Header="Center X (mm)" Binding="{Binding CenterX, StringFormat={}{0:0.#}}" Width="140"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
