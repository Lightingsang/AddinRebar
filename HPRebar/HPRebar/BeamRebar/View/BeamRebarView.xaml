<Window x:Class="HPRebar.BeamRebar.View.BeamRebarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:HPRebar.BeamRebar.ViewModel.Tabs"
        xmlns:views="clr-namespace:HPRebar.BeamRebar.View.Tabs"
        xmlns:controls="clr-namespace:HPRebar.BeamRebar.View.Controls"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Localization.Strings.WindowTitle}"
        Width="1100" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource Font.Family.Default}"
        FontSize="{DynamicResource Font.Size.Body}"
        Foreground="{DynamicResource Brush.Foreground.Primary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPRebar;component/Resources/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Tab DataTemplate Routing -->
            <DataTemplate DataType="{x:Type tabs:GeometryTabViewModel}"><views:GeometryTabView/></DataTemplate>
            <DataTemplate DataType="{x:Type tabs:MainBarsTabViewModel}"><views:MainBarsTabView/></DataTemplate>
            <DataTemplate DataType="{x:Type tabs:AdditionalBarsTabViewModel}"><views:AdditionalBarsTabView/></DataTemplate>
            <DataTemplate DataType="{x:Type tabs:StirrupsTabViewModel}"><views:StirrupsTabView/></DataTemplate>
            <DataTemplate DataType="{x:Type tabs:ViewsTabViewModel}"><views:ViewsTabView/></DataTemplate>

            <!-- Segmented Mode Selector Button Style -->
            <Style x:Key="SegmentedRadioButton" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Secondary}"/>
                <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.OnAccent}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource Spacing.Large}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="220"/>          <!-- Row 0: Navigation + Tab Content -->
            <RowDefinition Height="280" MinHeight="160"/>        <!-- Row 1: Real-time Preview Area (2D / 3D / Split) -->
            <RowDefinition Height="Auto"/>                       <!-- Row 2: Status & Footer Actions -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>      <!-- Col 0: Vertical Tab List -->
            <ColumnDefinition Width="*"/>        <!-- Col 1: Active Tab View -->
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <ListBox Grid.Row="0" Grid.Column="0"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding SelectedTab}"
                 Background="{DynamicResource Brush.Surface}"
                 BorderBrush="{DynamicResource Brush.Border}"
                 BorderThickness="1"
                 Foreground="{DynamicResource Brush.Foreground.Primary}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"
                               Margin="{DynamicResource Spacing.Small}"
                               FontSize="{DynamicResource Font.Size.BodyStrong}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Active Tab Content Area -->
        <ContentControl Grid.Row="0" Grid.Column="1"
                        Margin="{DynamicResource Spacing.MediumHorizontal}"
                        Content="{Binding SelectedTab}"/>

        <!-- Horizontal GridSplitter between Row 0 and Row 1 -->
        <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      ResizeDirection="Rows"
                      ShowsPreview="False"
                      Background="{DynamicResource Brush.Border}"
                      Cursor="SizeNS"/>

        <!-- Bottom Preview Container (Row 1) -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
              Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>       <!-- Header: Title & Segmented Mode Selector -->
                <RowDefinition Height="*"/>          <!-- Main Preview Panels -->
            </Grid.RowDefinitions>

            <!-- Preview Header & View Mode Selector -->
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <!-- Preview Title & Icon -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <md:PackIcon Kind="EyeOutline"
                                 Width="16" Height="16"
                                 Foreground="{DynamicResource Brush.Accent}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                    <TextBlock Text="PREVIEW"
                               FontWeight="Bold"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Foreground.Primary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="· Real-time Beam Visualization"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Foreground.Secondary}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Segmented Mode Selector: [2D Canvases] [3D Helix Viewport] [Split: 2D + 3D] -->
                <Border HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedRadioButton}"
                                     GroupName="PreviewModeGroup"
                                     IsChecked="{Binding IsTwoDMode}"
                                     ToolTip="Show 2D Elevation and Cross-Section Canvases">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="LayersOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="2D Canvases" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SegmentedRadioButton}"
                                     GroupName="PreviewModeGroup"
                                     IsChecked="{Binding IsThreeDMode}"
                                     Margin="2,0,0,0"
                                     ToolTip="Show Full 3D Helix Viewport">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CubeOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="3D Helix Viewport" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SegmentedRadioButton}"
                                     GroupName="PreviewModeGroup"
                                     IsChecked="{Binding IsSplitMode}"
                                     Margin="2,0,0,0"
                                     ToolTip="Show Side-by-Side Split View: 2D Elevation + 3D Viewport">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ViewSplitVertical" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Split: 2D + 3D" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Mode 1: [ 2D Canvases ] (Elevation + Section) -->
            <Grid Grid.Row="1" Visibility="{Binding IsTwoDMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>

                <!-- Elevation Preview Canvas -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,8,0">
                    <controls:BeamElevationCanvas Session="{Binding Session}"/>
                </Border>

                <!-- Cross-Section Preview Canvas -->
                <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <controls:BeamSectionCanvas Session="{Binding Session}"/>
                </Border>
            </Grid>

            <!-- Mode 2: [ 3D Helix Viewport ] (Full Width 3D View) -->
            <Grid Grid.Row="1" Visibility="{Binding IsThreeDMode, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <controls:Beam3DViewport Session="{Binding Session}"/>
                </Border>
            </Grid>

            <!-- Mode 3: [ Split: 2D + 3D ] (Elevation Left, 3D Viewport Right with Vertical Splitter) -->
            <Grid Grid.Row="1" Visibility="{Binding IsSplitMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- Left: 2D Elevation Canvas -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <controls:BeamElevationCanvas Session="{Binding Session}"/>
                </Border>

                <!-- Vertical Splitter between 2D and 3D -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ShowsPreview="False" Background="{DynamicResource Brush.Border}" Cursor="SizeWE"/>

                <!-- Right: 3D Helix Viewport -->
                <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <controls:Beam3DViewport Session="{Binding Session}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
              Margin="{DynamicResource Spacing.MediumTop}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{DynamicResource LinkButton}"
                    Content="{Binding Localization.Strings.LanguageToggle}"
                    Command="{Binding ToggleLanguageCommand}"/>

            <StackPanel Grid.Column="1" Margin="{DynamicResource Spacing.MediumHorizontal}">
                <ProgressBar Height="6"
                             Minimum="0"
                             Maximum="{Binding ProgressMaximum}"
                             Value="{Binding Progress}"
                             Background="{DynamicResource Brush.Surface}"
                             Foreground="{DynamicResource Brush.Accent}"
                             BorderThickness="0"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="{DynamicResource Spacing.SmallTop}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{DynamicResource SecondaryButton}"
                        Content="{Binding Localization.Strings.Cancel}"
                        Command="{Binding CancelCommand}"
                        MinWidth="96"/>
                <Button Style="{DynamicResource PrimaryButton}"
                        Content="{Binding Localization.Strings.Ok}"
                        Command="{Binding RunCommand}"
                        Margin="{DynamicResource Spacing.SmallHorizontal}"
                        MinWidth="96"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
