<UserControl x:Class="HPRebar.KataExport.View.Tabs.KataSpecialSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Secondary}"/>
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Chưa áp dụng: toàn bộ tab này dành cho công cụ shop thép (nối, cắt, khối lượng), chưa đổi thép vẽ ra."
                   FontStyle="Italic" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Foreground.Secondary}"/>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <CheckBox Content="Lấy khối lượng thép theo bảng dưới" IsChecked="{Binding UseUnitMassTable, Mode=TwoWay}" Style="{StaticResource Check}"/>
                <DataGrid ItemsSource="{Binding MassRows}" AutomationProperties.AutomationId="KataSettingsMassTable"
                          AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" MinHeight="120" MaxHeight="220" Margin="0,4,0,0"
                          Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ø (mm)" Binding="{Binding Diameter, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Khối lượng (kg/m)" Binding="{Binding KgPerM, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Thông tin nối thép" Style="{StaticResource Header}" Margin="0,0,0,4"/>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock DockPanel.Dock="Right" Text="d" Style="{StaticResource Unit}"/>
                    <TextBox DockPanel.Dock="Right" Width="70" Style="{DynamicResource NumberTextBox}" Text="{Binding CompressionLapFactor, Mode=TwoWay}"/>
                    <TextBlock Text="Nối thép vùng nén" Style="{StaticResource Label}"/>
                </DockPanel>
                <CheckBox Content="Cho phép nối ở vùng kéo" IsChecked="{Binding AllowTensionZoneLap, Mode=TwoWay}" Style="{StaticResource Check}"/>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock DockPanel.Dock="Right" Text="d" Style="{StaticResource Unit}"/>
                    <TextBox DockPanel.Dock="Right" Width="70" Style="{DynamicResource NumberTextBox}" IsEnabled="{Binding AllowTensionZoneLap}" Text="{Binding TensionLapFactor, Mode=TwoWay}"/>
                    <TextBlock Text="Nối thép vùng kéo" Style="{StaticResource Label}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource Unit}"/>
                    <TextBox DockPanel.Dock="Right" Width="70" Style="{DynamicResource NumberTextBox}" Text="{Binding CrankToLapEdgeMm, Mode=TwoWay}"/>
                    <TextBlock Text="Mép nhấn cách mép nối" Style="{StaticResource Label}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource Unit}"/>
                    <TextBox DockPanel.Dock="Right" Width="70" Style="{DynamicResource NumberTextBox}" Text="{Binding MinLapGapMm, Mode=TwoWay}"/>
                    <TextBlock Text="Khoảng cách min 2 mối nối" Style="{StaticResource Label}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource Unit}"/>
                    <TextBox DockPanel.Dock="Right" Width="70" Style="{DynamicResource NumberTextBox}" Text="{Binding CuttingToleranceMm, Mode=TwoWay}"/>
                    <TextBlock Text="Dung sai khi phối thép" Style="{StaticResource Label}"/>
                </DockPanel>
            </StackPanel>
        </Grid>

        <CheckBox Content="Ưu tiên lấy chiều dài neo nối thép theo bảng dưới (mm)" IsChecked="{Binding UseLapTable, Mode=TwoWay}" Style="{StaticResource Check}" Margin="0,12,0,0"/>
        <DataGrid ItemsSource="{Binding LapRows}" AutomationProperties.AutomationId="KataSettingsLapTable"
                  AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" MinHeight="120" MaxHeight="220" Margin="0,4,0,0"
                  Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ø (mm)" Binding="{Binding Diameter, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Nối nén" Binding="{Binding LapCompression, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Nối kéo" Binding="{Binding LapTension, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Neo nén" Binding="{Binding AnchorCompression, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Neo kéo" Binding="{Binding AnchorTension, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
