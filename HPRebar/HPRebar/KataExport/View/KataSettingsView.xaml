<Window x:Class="HPRebar.KataExport.View.KataSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tabs="clr-namespace:HPRebar.KataExport.View.Tabs"
        Title="Thiết lập thép Kata"
        Width="760" Height="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground.Primary}"
        FontFamily="{DynamicResource Font.Family.Default}"
        FontSize="{DynamicResource Font.Size.Body}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPRebar;component/Resources/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="CogOutline" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Thiết lập thép Kata" FontWeight="Bold" FontSize="{DynamicResource Font.Size.Subheading}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Giữ khớp với hộp 'Cài đặt thông số Kata'. Mục ghi 'chưa áp dụng' được lưu để dùng sau (shop thép), chưa đổi thép vẽ ra. Cửa sổ Kata Export đang mở: bấm Đọc thép Excel lại để dùng thiết lập mới."
                       Foreground="{DynamicResource Brush.Foreground.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8"/>
        </StackPanel>

        <TabControl Grid.Row="1" AutomationProperties.AutomationId="KataSettingsTabs">
            <TabItem Header="Detail thép" AutomationProperties.AutomationId="KataSettingsTabDetail">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <tabs:KataDetailSettingsTab DataContext="{Binding Detail}" Margin="4,8"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Thông số đặc thù" AutomationProperties.AutomationId="KataSettingsTabSpecial">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <tabs:KataSpecialSettingsTab DataContext="{Binding Special}" Margin="4,8"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Thép mặc định" AutomationProperties.AutomationId="KataSettingsTabJoints">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <tabs:KataJointDefaultsTab DataContext="{Binding Joints}" Margin="4,8"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding Message}" AutomationProperties.AutomationId="KataSettingsMessage"
                   Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Mặc định" Command="{Binding ResetDefaultCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Chấp nhận" AutomationProperties.AutomationId="KataSettingsAccept" Command="{Binding AcceptCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="Thoát" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
