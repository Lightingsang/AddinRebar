<Window x:Class="HPRebar.KataExport.View.KataSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thiết lập thép Kata"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground.Primary}"
        FontFamily="{DynamicResource Font.Family.Default}"
        FontSize="{DynamicResource Font.Size.Body}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPRebar;component/Resources/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SettingLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,4,8,4"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}"/>
            </Style>

            <Style x:Key="SettingUnit" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,4,0,4"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Secondary}"/>
            </Style>

            <Style x:Key="SettingBox" TargetType="TextBox" BasedOn="{StaticResource NumberTextBox}">
                <Setter Property="Width" Value="70"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <Style x:Key="GroupHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                <Setter Property="Margin" Value="0,10,0,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16,12,16,14">
        <StackPanel Orientation="Horizontal">
            <md:PackIcon Kind="CogOutline" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Thiết lập thép Kata" FontWeight="Bold" FontSize="{DynamicResource Font.Size.Subheading}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Giữ khớp với hộp 'Detail thép' của Kata; mặc định là giá trị của Kata và quy định thép dầm (TCVN 5574:2018)."
                   Foreground="{DynamicResource Brush.Foreground.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <TextBlock Text="Thanh thép &amp; Cắt bậc" Style="{StaticResource GroupHeader}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Chiều dài thép tối đa" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="1" AutomationProperties.AutomationId="KataSettingsMaxBarLength" Text="{Binding MaxBarLength, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource SettingUnit}"/>
            <TextBlock Grid.Row="1" Text="Làm tròn cắt thép gia cường" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RoundCutExtraMm, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource SettingUnit}"/>
            <TextBlock Grid.Row="2" Text="Cắt lệch gia cường gối (khi G1 trống)" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="KataSettingsCurtailedExtension" Text="{Binding CurtailedExtensionMm, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Style="{StaticResource SettingUnit}"/>
            <TextBlock Grid.Row="3" Text="Cắt thép gia cường bụng" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" AutomationProperties.AutomationId="KataSettingsBottomCutFraction" Text="{Binding BottomExtraCutFraction, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="x Ln" Style="{StaticResource SettingUnit}"/>
            <TextBlock Grid.Row="4" Text="Khoảng hở giữa các lớp thép" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="1" AutomationProperties.AutomationId="KataSettingsLayerClearGap" Text="{Binding LayerClearGap, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Text="mm" Style="{StaticResource SettingUnit}"/>
        </Grid>

        <TextBlock Text="Đai &amp; Vùng đai dày" Style="{StaticResource GroupHeader}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Đai □ bẻ móc" Style="{StaticResource SettingLabel}"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Width="70" Margin="0,2,8,2" ItemsSource="{Binding HookAngleOptions}" SelectedItem="{Binding ClosedStirrupHookAngle, Mode=TwoWay}"/>
            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding ClosedStirrupHookFactor, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="d" Style="{StaticResource SettingUnit}"/>
            <TextBlock Grid.Row="1" Text="Đai C bẻ móc" Style="{StaticResource SettingLabel}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Width="70" Margin="0,2,8,2" ItemsSource="{Binding HookAngleOptions}" SelectedItem="{Binding CrossTieHookAngle, Mode=TwoWay}"/>
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CrossTieHookFactor, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="d" Style="{StaticResource SettingUnit}"/>
            <TextBlock Grid.Row="2" Text="Vùng đai dày theo chiều cao" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="KataSettingsDenseHeightFactor" Text="{Binding DenseZoneHeightFactor, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Text="x h" Style="{StaticResource SettingUnit}"/>
            <TextBlock Grid.Row="3" Text="Vùng đai dày theo nhịp" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="2" AutomationProperties.AutomationId="KataSettingsEndZoneFraction" Text="{Binding EndZoneFraction, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="3" Grid.Column="3" Text="x Ln" Style="{StaticResource SettingUnit}"/>
        </Grid>

        <TextBlock Text="Cốt giá &amp; Neo" Style="{StaticResource GroupHeader}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Neo cốt giá vào gối" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="1" AutomationProperties.AutomationId="KataSettingsSideBarAnchorage" Text="{Binding SideBarAnchorageFactor, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="d" Style="{StaticResource SettingUnit}"/>
            <TextBlock Grid.Row="1" Text="Bước móc C giữ cốt giá" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SideBarTieSpacing, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource SettingUnit}"/>
            <TextBlock Grid.Row="2" Text="Dầm bắt buộc cốt giá (h ≥)" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="KataSettingsSideBarReqHeight" Text="{Binding SideBarRequiredHeight, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Style="{StaticResource SettingUnit}"/>
            <TextBlock Grid.Row="3" Text="Chân móc neo tối thiểu" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" AutomationProperties.AutomationId="KataSettingsMinLegFactor" Text="{Binding MinimumLegFactor, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="d" Style="{StaticResource SettingUnit}"/>
            <TextBlock Grid.Row="4" Text="Làm tròn chân móc neo" Style="{StaticResource SettingLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="1" AutomationProperties.AutomationId="KataSettingsRoundLeg" Text="{Binding RoundLegMm, Mode=TwoWay}" Style="{StaticResource SettingBox}"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Text="mm" Style="{StaticResource SettingUnit}"/>
        </Grid>

        <TextBlock Text="Nối chồng, bẻ cổ chai và coupler chưa áp dụng: thép chủ vẽ liền, dài quá chiều dài tối đa thì cảnh báo."
                   Foreground="{DynamicResource Brush.Foreground.Secondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Mặc định Kata" Command="{Binding ResetDefaultCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Chấp nhận" AutomationProperties.AutomationId="KataSettingsAccept" Command="{Binding AcceptCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="Thoát" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
