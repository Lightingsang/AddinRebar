<Window x:Class="HPRebar.KataExport.View.KataExportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HPRebar.KataExport.ViewModel"
        xmlns:controls="clr-namespace:HPRebar.KataExport.View.Controls"
        mc:Ignorable="d"
        Title="Xuất Dầm sang KATA Excel"
        Width="1040" Height="920"
        MinWidth="760" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground.Primary}"
        FontFamily="{DynamicResource Font.Family.Default}"
        FontSize="{DynamicResource Font.Size.Body}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPRebar;component/Resources/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- A card title: one bold line, no GroupBox header band (the window is short on height). -->
            <Style x:Key="KataCardTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}"/>
            </Style>
            <Style x:Key="KataCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource Spacing.Medium}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Border Style="{DynamicResource Badge}" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="HPRebar Kata" Style="{DynamicResource BadgeText}"/>
            </Border>
            <TextBlock Text="Xuất Dữ Liệu Dầm Sang KATA Excel"
                       ToolTip="Đo 1D dọc trục dầm: gối, nhịp, cao trình, dầm giao và lệch trục, ghi vào sheet Dam của KATA."
                       FontSize="{DynamicResource Font.Size.Subheading}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Parameters, direction and what was read -->
        <Border Grid.Row="1" Style="{StaticResource KataCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="Tên dầm (B3):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding AvailableParameters}"
                              SelectedItem="{Binding SelectedNameParameter, Mode=TwoWay}"
                              Height="28"/>
                </DockPanel>

                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,8">
                    <TextBlock Text="Số lượng (B4):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding AvailableParameters}"
                              SelectedItem="{Binding SelectedCountParameter, Mode=TwoWay}"
                              Height="28"/>
                </DockPanel>

                <CheckBox Grid.Row="0" Grid.Column="2"
                          Content="Đảo chiều (Reverse)"
                          IsChecked="{Binding IsReverse, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,0,8"/>

                <UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Columns="4">
                    <UniformGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="Margin" Value="0,0,8,0"/>
                        </Style>
                    </UniformGrid.Resources>
                    <StackPanel>
                        <TextBlock Text="Số đoạn / chiều dài" Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding BeamCountText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TotalLengthText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Tiết diện / cao trình (B5 B6 B10)" Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding SectionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ElevationText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Chiều dày sàn (B7)" Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                        <TextBlock Text="{Binding SlabThicknessText}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Trục dầm (B8 / B9)" Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding AxisText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AxisOffsetText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Elevation: every number drawn is the text of the Kata cell it stands for -->
        <Border Grid.Row="2" Style="{StaticResource KataCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="Mặt đứng dải dầm" Style="{StaticResource KataCardTitle}" Margin="0,0,12,0"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="‹ Trước"
                                Command="{Binding PreviousSpanCommand}"
                                Style="{DynamicResource SecondaryButton}"
                                Padding="10,2" Height="26" Margin="0,0,6,0"/>
                        <Button Content="Tiếp ›"
                                Command="{Binding NextSpanCommand}"
                                Style="{DynamicResource SecondaryButton}"
                                Padding="10,2" Height="26" Margin="0,0,6,0"/>
                        <Button Content="Toàn dải"
                                Command="{Binding FrameAllCommand}"
                                Style="{DynamicResource SecondaryButton}"
                                Padding="10,2" Height="26"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="Lăn: phóng · Giữa / Shift+kéo: di chuyển · Nhấp đúp: toàn dải"
                               ToolTip="Lăn chuột: phóng quanh con trỏ · Giữ chuột giữa hoặc Shift + kéo chuột trái: di chuyển · Bấm trái: chọn cột Kata · Nhấp đúp: xem toàn dải"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.Foreground.Secondary}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectionText}"
                               ToolTip="{Binding SelectionText}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0"/>
                </DockPanel>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <controls:KataElevationCanvas Elevation="{Binding Elevation}"
                                                  SelectedColumnIndex="{Binding SelectedColumnIndex, Mode=TwoWay}"
                                                  FocusRequest="{Binding FocusRequest}"
                                                  SurfaceBrush="{DynamicResource Brush.Canvas.Fill}"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Preview table: one column per Kata column, selection shared with the elevation -->
        <Border Grid.Row="3" Style="{StaticResource KataCard}">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="Ô ghi sang KATA (cột C..BZ)" Style="{StaticResource KataCardTitle}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding HeaderLine}"
                               ToolTip="{Binding HeaderLine}"
                               FontFamily="{DynamicResource Font.Family.Mono}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Foreground.Secondary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Margin="0,2,8,0">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Height" Value="17"/>
                                <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Secondary}"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="Cột"/>
                        <TextBlock Text="Loại"/>
                        <TextBlock Text="11 gối / nhịp"/>
                        <TextBlock Text="19 cột trên / z"/>
                        <TextBlock Text="21 dầm giao / đáy"/>
                        <TextBlock Text="22 tên trục"/>
                        <TextBlock Text="23 lệch trục"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding PreviewColumns}"
                             SelectedIndex="{Binding SelectedColumnIndex, Mode=TwoWay}"
                             controls:ListBoxScrollSelection.IsEnabled="True"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="MinWidth" Value="58"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KataPreviewColumn}">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Height" Value="17"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
                                            <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Mono}"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="{Binding Letter}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Kind}"
                                               FontFamily="{DynamicResource Font.Family.Default}"
                                               Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                                    <TextBlock Text="{Binding Row11}"/>
                                    <TextBlock Text="{Binding Row19}"/>
                                    <TextBlock Text="{Binding Row21}"/>
                                    <TextBlock Text="{Binding Row22}"/>
                                    <TextBlock Text="{Binding Row23}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Warnings -->
        <Border Grid.Row="4"
                Background="{DynamicResource Brush.SurfaceElevated}"
                BorderBrush="{DynamicResource Brush.Warning}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,4"
                Margin="0,0,0,8"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="Cảnh báo:"
                           FontWeight="Bold"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Warning}"
                           Margin="0,0,8,0"/>
                <ScrollViewer MaxHeight="52" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource Font.Size.Caption}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Target workbook, status and actions -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Chọn lại dầm"
                    Command="{Binding RepickCommand}"
                    Style="{DynamicResource SecondaryButton}"
                    Padding="14,6"
                    Height="32"
                    Margin="0,0,8,0"/>

            <Button Grid.Column="1"
                    Content="Kiểm tra lại Excel"
                    Command="{Binding RefreshProbeCommand}"
                    Style="{DynamicResource SecondaryButton}"
                    Padding="10,6"
                    Height="32"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="{Binding TargetWorkbook}"
                           ToolTip="{Binding TargetWorkbook}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding StatusMessage}"
                           ToolTip="{Binding StatusMessage}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Secondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="3"
                    Content="Đóng"
                    Command="{Binding CloseCommand}"
                    Style="{DynamicResource SecondaryButton}"
                    Padding="16,6"
                    Height="32"
                    Margin="0,0,8,0"/>

            <Button Grid.Column="4"
                    Content="Xuất Excel"
                    Command="{Binding ExportCommand}"
                    Style="{DynamicResource PrimaryButton}"
                    Padding="20,6"
                    Height="32"/>
        </Grid>
    </Grid>
</Window>
