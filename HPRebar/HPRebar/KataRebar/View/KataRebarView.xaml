<Window x:Class="HPRebar.KataRebar.View.KataRebarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:HPRebar.KataRebar.ViewModel"
        mc:Ignorable="d"
        Title="HPRebar — Bố trí Cốt thép Dầm từ KATA (Sheet Dam)"
        Width="1120" Height="780"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground.Primary}"
        FontFamily="{DynamicResource Font.Family.Default}"
        FontSize="{DynamicResource Font.Size.Body}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HPRebar;component/Resources/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="BadgeBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.GridLine}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.GridLine}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
            </Style>

            <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.GridLine}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header Information Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DẦM:" FontWeight="Bold" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Accent}"/>
                    <TextBlock Text="{Binding BeamName, FallbackValue='(Chưa nạp)'}" FontWeight="Bold" FontSize="16" Margin="0,0,16,0"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource BadgeBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tiết diện: " Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                            <TextBlock Text="{Binding DimensionsText, FallbackValue='-'}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource BadgeBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tầng: " Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                            <TextBlock Text="{Binding LevelText, FallbackValue='-'}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource BadgeBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Nhịp: " Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                            <TextBlock Text="{Binding SpansCountText, FallbackValue='-'}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource BadgeBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Chiều dài: " Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                            <TextBlock Text="{Binding TotalLengthText, FallbackValue='-'}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource BadgeBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Khối lượng thép: " Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                            <TextBlock Text="{Binding SteelWeightText, FallbackValue='-'}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content Split View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Data Source & Project Types -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <!-- Card A: Nguồn Excel -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Nguồn dữ liệu KATA (Sheet Dam)" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding WorkbookName}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Đọc từ workbook đang kích hoạt trong Excel (kể cả chỉnh sửa chưa lưu)."
                                       FontSize="{DynamicResource Font.Size.Caption}" Foreground="{DynamicResource Brush.Foreground.Secondary}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Content="Đọc lại Excel" Command="{Binding RefreshFromExcelCommand}"
                                    AutomationProperties.AutomationId="KataRebarRefreshExcel"/>
                        </StackPanel>
                    </Border>

                    <!-- Card B: Khớp Dầm Revit -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Dải dầm mô hình Revit" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding MatchStatusText}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource Brush.Foreground.Secondary}"/>

                            <Button Content="Chọn dầm trong Revit" Command="{Binding RepickBeamsCommand}"
                                    AutomationProperties.AutomationId="KataRebarPickBeams"/>
                        </StackPanel>
                    </Border>

                    <!-- Card C: Ghép nối RebarBarType -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Ghép nối Kiểu thép Revit" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="Khớp theo đường kính (±0.5 mm). Đường kính không có kiểu thép sẽ để trống: tải kiểu thép vào dự án hoặc chọn kiểu khác."
                                       FontSize="{DynamicResource Font.Size.Caption}" Foreground="{DynamicResource Brush.Foreground.Secondary}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <DataGrid ItemsSource="{Binding BarTypeMappings}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource Brush.GridLine}"
                                      RowStyle="{StaticResource DataGridRowStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                      MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Ký hiệu" Binding="{Binding Notation}" Width="65" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="RebarBarType Revit" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding AvailableTypes}"
                                                          SelectedItem="{Binding SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMemberPath="Name"
                                                          VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Pane: Tabs for Structural Rebar Detailing -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="4">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- Tab 1: Cốt thép dọc (Chủ, Gia cường, Thép mang) -->
                    <TabItem Header="Cốt thép dọc" FontWeight="SemiBold">
                        <DataGrid ItemsSource="{Binding BarLayersPreview}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource Brush.GridLine}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                  Margin="4,8,4,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nhóm thép" Binding="{Binding Category}" Width="150"/>
                                <DataGridTextColumn Header="Vị trí" Binding="{Binding Location}" Width="140"/>
                                <DataGridTextColumn Header="Ký hiệu" Binding="{Binding Notation}" Width="100"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding Count}" Width="70"/>
                                <DataGridTextColumn Header="Đường kính" Binding="{Binding DiameterMm, StringFormat='Ø{0:0.#}'}" Width="85"/>
                                <DataGridTextColumn Header="Chi tiết bố trí" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Tab 2: Thông số Nhịp & Gối -->
                    <TabItem Header="Nhịp &amp; Gối dầm" FontWeight="SemiBold">
                        <DataGrid ItemsSource="{Binding SpansPreview}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource Brush.GridLine}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                  Margin="4,8,4,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nhịp #" Binding="{Binding SpanNumber}" Width="60"/>
                                <DataGridTextColumn Header="Bề rộng gối trái" Binding="{Binding LeftColumnWidthMm, StringFormat='{}{0:0} mm'}" Width="115"/>
                                <DataGridTextColumn Header="Chiều dài tịnh (Ln)" Binding="{Binding ClearSpanLengthMm, StringFormat='{}{0:0} mm'}" Width="135"/>
                                <DataGridTextColumn Header="Bề rộng gối phải" Binding="{Binding RightColumnWidthMm, StringFormat='{}{0:0} mm'}" Width="115"/>
                                <DataGridTextColumn Header="Khoảng rải đai (Gối/Nhịp)" Binding="{Binding StirrupSpacing}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Tab 3: Phân bố Cốt đai 3 Vùng -->
                    <TabItem Header="Phân bố Cốt đai" FontWeight="SemiBold">
                        <DataGrid ItemsSource="{Binding StirrupZonesPreview}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource Brush.GridLine}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                  Margin="4,8,4,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vùng rải" Binding="{Binding ZoneName}" Width="120"/>
                                <DataGridTextColumn Header="Bắt đầu X" Binding="{Binding StartStationX, StringFormat='{}{0:0} mm'}" Width="95"/>
                                <DataGridTextColumn Header="Kết thúc X" Binding="{Binding EndStationX, StringFormat='{}{0:0} mm'}" Width="95"/>
                                <DataGridTextColumn Header="Bước đai" Binding="{Binding Spacing, StringFormat='a{0:0}'}" Width="80"/>
                                <DataGridTextColumn Header="Số đai" Binding="{Binding Count}" Width="70"/>
                                <DataGridTextColumn Header="Kích thước đai (B x H)" Width="150">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0:0} × {1:0} mm">
                                            <Binding Path="OutToOutWidth"/>
                                            <Binding Path="OutToOutHeight"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Hình dạng" Binding="{Binding StirrupType}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Tab 4: Cảnh báo & Ghi chú -->
                    <TabItem Header="Cảnh báo &amp; Bỏ qua" FontWeight="SemiBold"
                             AutomationProperties.AutomationId="KataRebarMessagesTab">
                        <ListBox ItemsSource="{Binding Messages}" AutomationProperties.AutomationId="KataRebarMessages" Margin="4,8,4,4" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="• " FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 3. Footer Bar: Status & Primary Action Buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="KataRebarStatus">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,16,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Tạo cốt thép 3D"
                    AutomationProperties.AutomationId="KataRebarGenerate"
                    Command="{Binding GenerateRebarCommand}"
                    FontWeight="Bold"
                    Padding="20,8"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="2"
                    Content="Đóng"
                    AutomationProperties.AutomationId="KataRebarClose"
                    Command="{Binding CloseCommand}"
                    Padding="16,8"/>
        </Grid>
    </Grid>
</Window>
