<Project Sdk="Nice3point.Revit.Sdk/6.2.3">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <DeployAddin>true</DeployAddin>
        <LaunchRevit>true</LaunchRevit>
        <IsRepackable>true</IsRepackable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Configurations>Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition="'$(KataOnly)' == 'true'">
        <DefineConstants>$(DefineConstants);KATA_ONLY</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!-- Revit Dependencies -->
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*"/>

        <!-- UI -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
        <!-- Control styles. ILRepack-merged into HPRebar.dll like every other dependency: no assembly named
             MaterialDesignThemes.Wpf ever exists in Revit, so another add-in's copy cannot be mixed in (WPF binds
             BAML by simple name). Needs ThemeInfo.cs; the window font stays Segoe UI (see MaterialBridge.xaml). -->
        <PackageReference Include="MaterialDesignThemes" Version="5.3.2"/>

        <!-- Logging -->
        <PackageReference Include="Serilog" Version="4.4.0"/>
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>

        <!-- Build Automation-->
        <PackageReference Include="ILRepack" Version="2.0.46"/>

        <!-- Excel OpenXML Reader -->
        <PackageReference Include="ClosedXML" Version="0.104.2"/>

        <!-- Development Dependencies -->
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
        <PackageReference Include="Polyfill" Version="11.0.1" PrivateAssets="all"/>
    </ItemGroup>

    <!-- Kata Export web window, Revit 2026 only (ADR-0010). WebView2 is compile-only at the version Revit 2026 ships:
         nothing is copied, so ILRepack has nothing to merge and the add-in binds to the copy beside Revit.exe. The
         other versions keep the WPF window and never compile the web sources. -->
    <ItemGroup Condition="'$(RevitVersion)' == '2026'">
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2478.35"
                          ExcludeAssets="runtime;native;build;buildTransitive" PrivateAssets="all"/>
        <!-- Shared WebView2 hosting, ILRepack-merged into HPRebar.dll like every dependency. -->
        <ProjectReference Include="..\HPWebHost\HPWebHost.csproj"/>
    </ItemGroup>

    <!-- The Kata Export page (kata.html of HPBimToolkit.Frontend), embedded for the Revit 2026 web window. -->
    <Import Project="..\HPBimToolkit.Frontend\embed-frontend.targets" Condition="'$(RevitVersion)' == '2026'"/>

    <ItemGroup Condition="'$(RevitVersion)' != '2026'">
        <Compile Remove="KataExport\View\Web\**"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HPRebar.Core\HPRebar.Core.csproj"/>
    </ItemGroup>

</Project>