      "Code": "# -*- coding: utf-8 -*-\nimport json\n\nfile_path = IN[0]\nwith open(file_path, 'r', encoding='utf-8') as f:\n    data = json.load(f)\n\n# Quy đổi ZOffset từ mm sang Feet cho Revit\nOUT = [float(b.get('ZOffsetMm', 0)) / 304.8 for b in data.get('beams', [])]\n",
